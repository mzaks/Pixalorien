// Sounds of the effects (effects.ent), made up as tones (devices/sound):
// a ping as a scan's pulse goes out, a chime when the scan is done, a
// low growl over a hiss when the team hears a creature cry. Only for the
// ticks the world plays forward in a frame (not going to a tick, not
// going back), each once.
import sound
import matter
import view
import team
import turns
import tools
import creatures
import effects

// The tick the sounds were made up to.
transient unique Heard { last: i32, pings: i32 }

system sounds() {
  let now = Sim.tick
  let last = Heard.last
  Heard.last = now
  let fresh = now > last && now - last <= 8 && !Replay.on && !Back.on && !Back.play
  if fresh {
    let d = now - last
    Heard.pings = 0
    for p: Pixalorien in turn by p.id {
      if p.order == SCAN && p.busy && !p.down && p.work % SCAN_PULSE < d { Heard.pings += 1 }
    }
    if Heard.pings > 0 { tone(1500.0, 1100.0, 0.07, 0.0, 0.10, Wave.Sine) }
    if Tools.st > last && Tools.st <= now {
      tone(880.0, 880.0, 0.10, 0.0, 0.14, Wave.Sine)
      tone(1320.0, 1320.0, 0.22, 0.09, 0.14, Wave.Sine)
    }
    var cried = false
    for i in 0..NOISES {
      let at = Noises[i].until - CRY_TICKS
      if Noises[i].from == 1 && Noises[i].heard && at > last && at <= now { cried = true }
    }
    if cried {
      tone(150.0, 85.0, 0.45, 0.0, 0.30, Wave.Triangle)
      tone(400.0, 200.0, 0.25, 0.0, 0.05, Wave.Noise)
    }
  }
}
