// Pixalorien: three Pixaloriens land on a desert planet to bring back a
// treasure from deep under its surface. Steps 1 to 8: the world,
// its automaton, the view, light and sight, the team, turns and orders,
// tools and matter, creatures, strategies and going back,
// the views, the goal; the HUD, the menus (dummies), the tutorial; time
// that runs, stops by itself, and runs backwards. Run from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../pixalorien.ent
import window
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools
import creatures
import views
import goal
import hud
import alarms
import menus
import tutorial
import journal
import sfx
import landing
import music
import world
import saver

// The files the game loads as it runs, taken along by `ent build`
// (in the program itself with --embed): the fonts (hud.ent,
// alarms.ent, menus.ent), the pictures (hud.ent, menus.ent,
// tutorial.ent) and the music loops (music.ent).
asset "fonts/m5x7.ttf"
asset "fonts/Silkscreen-Bold.ttf"
asset "fonts/Jersey10-Regular.ttf"
asset "art/sprites.png"
asset "art/round3/marketing-art.png"
asset "art/sergeant_talk.png"
asset "music/loops/title.ogg"
asset "music/loops/land.ogg"
asset "music/loops/calm.ogg"
asset "music/loops/open.ogg"
asset "music/loops/under.ogg"
asset "music/loops/deep.ogg"
asset "music/loops/danger.ogg"
asset "music/loops/win.ogg"
asset "music/loops/lost.ogg"

world {
  Window.width = 1440
  Window.height = 810
  Window.title = "Pixalorien"
  Window.fps = 60
  Window.escape = true
  Places.seed = 1
  Sim.run = true
}

transient unique Every { mini: i32 }

system mini_due() { Every.mini += 1 }

schedule start() {
  load_fonts()
  load_menu()
  load_tutorial()
  load_alarms()
  make()
  new_loot()
  populate()
  place_creatures()
  landed()
  disembark()
  eyes()
  sight()
  navigate()
  unfresh()
  look_at_ship()
}

// A new world when asked (a new game, the tutorial, N), as `start` makes
// one.
schedule new_world() {
  renew()
  plan() run_if Camera.again && !Menu.teach
  lay() run_if Camera.again && !Menu.teach
  build() run_if Camera.again && !Menu.teach
  course() run_if Camera.again && Menu.teach
  wake_all() run_if Camera.again
  populate() run_if Camera.again && !Menu.teach
  tut_fauna() run_if Camera.again && Menu.teach
  place_creatures() run_if Camera.again
  forget() run_if Camera.again
  landed() run_if Camera.again
  disembark() run_if Camera.again
  new_loot() run_if Camera.again
  eyes() run_if Camera.again
  cast() run_if Camera.again
  next_round() run_if Camera.again
  see() run_if Camera.again
  navigate() run_if Camera.again
  unfresh() run_if Camera.again
  fresh_turns() run_if Camera.again
  lessons_begin() run_if Camera.again && Menu.teach
}

schedule frame() {
  begin()
  tick()
  to_load() run_if Replay.load
  save_world_join() run_if Replay.load
  load_world() run_if Replay.load
  after_load() run_if Replay.load
  live()
  steer()
  new_world()
  sum_chosen()
  pause_key() run_if !Mode.on
  mode_input() run_if !Menu.teach
  time_clicks() run_if !Replay.on && !Mode.on
  strip_clicks() run_if !Replay.on && !Mode.on
  pause_track() run_if !Menu.teach
  pause_click() run_if !Replay.on && !Menu.teach && !Mode.on
  command() run_if !Replay.on && !Mode.on
  alarm_input()
  new_world_key()
  go_back() run_if Replay.ask
  pack() run_if !Back.ready
  undo_reset() run_if !Back.ready
  sim()
  alerts()
  arrange()
  a_view()
  a_view()
  a_view()
  point()
  count_flares() run_if Menu.teach
  teach() run_if Menu.teach
  paint_mini() run_if Every.mini % 15 == 0
  mini_due()
  draw_mini()
  draw_cam()
  draw_box()
  draw_tip()
  draw_strip()
  draw_time()
  draw_goal()
  draw_lesson() run_if Menu.teach
  draw_alarm()
  draw_pause() run_if !Menu.teach
  draw_mode() run_if !Menu.teach
  sounds()
  stream_out()
  tunes()
  present()
}

// Going to a tick: the world played quickly, without drawing; or taken
// back a tick at a time by the undo log (journal.ent).
schedule quick() {
  fast()
  sim()
  replay_done()
}

// A menu over the world as it stands (or over the key art).
schedule menu() {
  begin()
  menu_input()
  // The world settles while the menu is up before the first game
  // (step's systems run only where Sim.run): with the descent's, play
  // starts mostly settled. (Not over a game begun: that world moves
  // only by its ticks, which the log and a replay know.)
  menu_settles()
  step()
  arrange()
  a_view()
  a_view()
  a_view()
  draw_mini()
  draw_strip()
  draw_time()
  draw_menu()
  present()
}

// N in play: the world is left for a new one, flown in to.
schedule again() { fly_again() }

main {
  start()
  loop {
    loop { menu()  tunes() } until Menu.screen == PLAY || Menu.quit || Window.closed
    // A new world (or the same one, Continue), its landing, and play;
    // again from a new world while N asks for one.
    loop {
      again()
      new_world()
      take_off()
      loop { descend()  tunes() } until !Landing.on || Window.closed
      loop {
        frame()
        loop { quick() } until !Replay.on && Play.left == 0 || Replay.full || Window.closed
        loop { rewind() } until Back.left == 0 || Window.closed
      } until Menu.screen != PLAY || Menu.fly || Menu.quit || Window.closed
    } until Menu.screen != PLAY || Menu.quit || Window.closed
  } until Menu.quit || Window.closed
}
