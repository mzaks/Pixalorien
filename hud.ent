// The time band, above the strip: buttons (to the landing, back 30 and
// 5 seconds, run or stop, the speeds), the timeline (the game so far,
// the moment shown on it, marks where one went down, where the game
// paused itself, where a catastrophe came, and small ones where orders
// were given), the time, and to the furthest moment. A click or a drag
// on the timeline goes there (on letting go).
fn band_y(wh: f32) -> f32 { wh - (STRIP + BAND) as f32 }
// The buttons: 0 to the landing, 1 back 30, 2 back 5, 3 run/stop,
// 4..6 speeds 1, 2, 4; 7 to the furthest moment.
fn tbutton_x(i: i32, ww: f32) -> f32 {
  if i == 0 { 8.0 } else if i == 1 { 72.0 } else if i == 2 { 136.0 } else if i == 3 { 200.0 }
  else if i < 7 { 268.0 + (i - 4) as f32 * 40.0 } else { ww - 72.0 }
}
fn tbutton_w(i: i32) -> f32 { if i <= 3 { 58.0 } else if i < 7 { 36.0 } else { 64.0 } }
fn tbutton_word(i: i32, run: bool) -> text[8] {
  if i == 0 { "START" } else if i == 1 { "-30S" } else if i == 2 { "-5S" } else if i == 3 { if run { "STOP" } else { "RUN" } }
  else if i == 4 { "1X" } else if i == 5 { "2X" } else if i == 6 { "4X" } else { "NOW" }
}
fn tbutton_tip(i: i32) -> text[48] {
  if i == 0 { "watch the game again from the landing" } else if i == 1 { "back 30 seconds, stopped there" }
  else if i == 2 { "back 5 seconds, stopped there" } else if i == 3 { "run or stop the world" }
  else if i < 7 { "the world's speed" } else { "on to where the game stands" }
}
fn tbutton_key(i: i32) -> text[12] {
  if i == 0 { "HOME" } else if i == 1 { "SHIFT+R" } else if i == 2 { "R" } else if i == 3 { "SPACE" }
  else if i < 7 { ", ." } else { "END" }
}
fn line_x0() -> f32 { 400.0 }
fn line_x1(ww: f32) -> f32 { ww - 200.0 }
// The ticks the timeline spans: the game so far, at least a minute.
fn span(reach: i32) -> i32 { max(reach, 60 * SECOND) }
fn tick_at(mx: f32, ww: f32, reach: i32) -> i32 {
  let part = clamp((mx - line_x0()) / (line_x1(ww) - line_x0()), 0.0, 1.0)
  min(reach, (part * span(reach) as f32) as i32)
}
fn x_of(t: i32, ww: f32, reach: i32) -> f32 { line_x0() + (line_x1(ww) - line_x0()) * t as f32 / span(reach) as f32 }

// A triangle of pixels, pointing right (`dir` 1) or left (-1).
proc arrow(x: f32, y: f32, h: f32, dir: f32, color: i32) {
  let n = h / 4.0
  for i in 0..n as i32 {
    let k = i as f32
    rect(if dir > 0.0 { x + k * 2.0 } else { x - k * 2.0 - 2.0 }, y + k * 2.0, 2.0, h - k * 4.0, color)
  }
}

system time_clicks() {
  let ww = Window.width as f32
  let by = band_y(Window.height as f32)
  let mx = Mouse.x
  let my = Mouse.y
  let press = Mouse.left && !Hud.was_left
  let inband = my >= by && my < by + BAND as f32
  if press && inband {
    for i in 0..8 {
      if inside_box(mx, my, tbutton_x(i, ww), by + 6.0, tbutton_w(i), 28.0) {
        if i == 0 {
          Replay.target = 0
          Replay.run = true
          Replay.ask = true
        } else if i == 1 || i == 2 {
          Replay.target = max(0, Now.tick - (if i == 1 { KEEP_EVERY } else { RING_EVERY }))
          Replay.run = false
          Replay.ask = true
        } else if i == 3 { Play.run = !Play.run }
        else if i < 7 { Play.speed = if i == 4 { 1 } else if i == 5 { 2 } else { 4 } }
        else {
          Replay.target = Line.reach
          Replay.run = Play.run
          Replay.ask = true
        }
      }
    }
    if mx >= line_x0() && mx <= line_x1(ww) { Hud.drag = true }
  }
  if Hud.drag { Hud.dx = mx }
  if Hud.drag && !Mouse.left {
    Hud.drag = false
    Replay.target = tick_at(mx, ww, Line.reach)
    Replay.run = false
    Replay.ask = true
  }
}

system draw_time() {
  let ww = Window.width as f32
  let by = band_y(Window.height as f32)
  let small = Type.small
  let head = Type.head
  let mx = Mouse.x
  let my = Mouse.y
  rect(0.0, by, ww, BAND as f32, PANEL)
  rect(0.0, by, ww, 2.0, EDGE)
  let reach = Line.reach
  for i in 0..8 {
    let bx = tbutton_x(i, ww)
    let bw = tbutton_w(i)
    let on = i == 3 && Play.run || i >= 4 && i < 7 && Play.speed == (if i == 4 { 1 } else if i == 5 { 2 } else { 4 })
    let can = i != 7 || Now.tick < reach
    let over = can && inside_box(mx, my, bx, by + 6.0, bw, 28.0)
    rect(bx, by + 6.0, bw, 28.0, if on { 0x0e3a44 } else if over { 0x2e2018 } else { INSET })
    let edge = if on { CYAN } else if over { EDGE_HI } else if can { EDGE } else { 0x3a2418 }
    rect(bx, by + 6.0, bw, 2.0, edge)
    rect(bx, by + 32.0, bw, 2.0, edge)
    rect(bx, by + 6.0, 2.0, 28.0, edge)
    rect(bx + bw - 2.0, by + 6.0, 2.0, 28.0, edge)
    let ink = if on { CYAN } else if can { INK } else { OFF }
    write("{tbutton_word(i, Play.run)}", bx, by + 13.0, bw, head, 16.0, 0.0, 0.0, 2, 1, ink)
  }
  // The timeline.
  let x0 = line_x0()
  let x1 = line_x1(ww)
  let ly = by + 12.0
  rect(x0, ly, x1 - x0, 16.0, 0x2a1e18)
  let xr = x_of(reach, ww, reach)
  rect(x0, ly, xr - x0, 16.0, 0x5a3a18)
  let xn = x_of(Now.tick, ww, reach)
  rect(x0, ly, xn - x0, 16.0, if Now.tick < reach { 0x1a6a7a } else { 0x8a6a30 })
  // A tick a minute.
  for m in 1..span(reach) / (60 * SECOND) + 1 {
    let x = x_of(m * 60 * SECOND, ww, reach)
    rect(x, ly + 12.0, 2.0, 4.0, DIM)
  }
  for r in 0..Line.rows {
    rect(x_of(OrderLog[r].tick, ww, reach), ly - 3.0, 2.0, 3.0, CYAN)
  }
  for k in 0..Marked.n {
    let x = x_of(Pins[k].tick, ww, reach)
    let kind = Pins[k].kind
    let c = if kind == MARK_DOWN { RED } else if kind == MARK_PAUSE { AMBER } else { 0xff8020 }
    rect(x - 1.0, ly - 4.0, 3.0, 24.0, c)
    if kind == MARK_DOWN { rect(x - 3.0, ly - 6.0, 7.0, 4.0, c) }
  }
  // The moment shown, and where a drag would go.
  rect(xn - 2.0, ly - 6.0, 4.0, 28.0, 0xffffff)
  if Replay.on {
    let xt = x_of(Replay.target, ww, reach)
    rect(xt - 1.0, ly - 6.0, 2.0, 28.0, CYAN)
  }
  if Hud.drag {
    let t = tick_at(Hud.dx, ww, reach)
    let xd = x_of(t, ww, reach)
    rect(xd - 1.0, ly - 6.0, 3.0, 28.0, CYAN)
    write("{clock_text(t)}", xd - 40.0, by - 20.0, 80.0, head, 16.0, 0.0, 0.0, 2, 1, CYAN)
  }
  write("{clock_text(Now.tick)} / {clock_text(reach)}", x1 + 10.0, by + 13.0, 120.0, head, 16.0, 0.0, 0.0, 2, 0,
        if Now.tick < reach { CYAN } else { INK })
  // Tips.
  if my >= by && my < by + BAND as f32 && !Hud.drag {
    for i in 0..8 {
      if inside_box(mx, my, tbutton_x(i, ww), by + 6.0, tbutton_w(i), 28.0) {
        tip("{tbutton_word(i, Play.run)}  [{tbutton_key(i)}]", tbutton_tip(i), AMBER, mx, my, true, head, small, ww, by)
      }
    }
    if mx >= x0 && mx <= x1 {
      let t = tick_at(mx, ww, reach)
      rect(x_of(t, ww, reach) - 1.0, ly - 6.0, 2.0, 28.0, 0x80ffffff)
      tip("GO TO {clock_text(t)}", "click or drag: the world as it was then", CYAN, mx, my, true, head, small, ww, by)
    }
  }
}
