// The card's letters (share.ent): the game's three fonts drawn, each
// letter in a cell of its own, white on black, and saved as
// art/card_glyphs.png; under them, a row a font, how far on each letter
// goes (its advance, in the red of a pixel). The card copies them, as no
// font is drawn into a picture. Run again when a font changes, from the
// repository (the picture is taken at one pixel a point):
//   ENT_WINDOW_SCALE=1 ../ent-lang/tools/ent run tools/card_glyphs.ent
//   mv card_glyphs.png art/
// Letters 32 to 126 but for " \ { }, which a text here cannot hold.
import window
import console

// Per font: the cell's width and height, its size, where its rows begin.
const PER_ROW = 32
const SHEET_W = 1280
const SHEET_H = 300

world {
  Window.width = SHEET_W
  Window.height = SHEET_H
  Window.title = "card glyphs"
  Window.fps = 0
  Window.background = 0x000000
}

transient unique Fonts { small: i32, head: i32, big: i32, shot: bool }

fn glyph(g: i32) -> text[1] {
  var v: text[1] = ""
  if g == 1 { v = "!" }
  if g == 3 { v = "#" }
  if g == 4 { v = "$" }
  if g == 5 { v = "%" }
  if g == 6 { v = "&" }
  if g == 7 { v = "'" }
  if g == 8 { v = "(" }
  if g == 9 { v = ")" }
  if g == 10 { v = "*" }
  if g == 11 { v = "+" }
  if g == 12 { v = "," }
  if g == 13 { v = "-" }
  if g == 14 { v = "." }
  if g == 15 { v = "/" }
  if g == 16 { v = "0" }
  if g == 17 { v = "1" }
  if g == 18 { v = "2" }
  if g == 19 { v = "3" }
  if g == 20 { v = "4" }
  if g == 21 { v = "5" }
  if g == 22 { v = "6" }
  if g == 23 { v = "7" }
  if g == 24 { v = "8" }
  if g == 25 { v = "9" }
  if g == 26 { v = ":" }
  if g == 27 { v = ";" }
  if g == 28 { v = "<" }
  if g == 29 { v = "=" }
  if g == 30 { v = ">" }
  if g == 31 { v = "?" }
  if g == 32 { v = "@" }
  if g == 33 { v = "A" }
  if g == 34 { v = "B" }
  if g == 35 { v = "C" }
  if g == 36 { v = "D" }
  if g == 37 { v = "E" }
  if g == 38 { v = "F" }
  if g == 39 { v = "G" }
  if g == 40 { v = "H" }
  if g == 41 { v = "I" }
  if g == 42 { v = "J" }
  if g == 43 { v = "K" }
  if g == 44 { v = "L" }
  if g == 45 { v = "M" }
  if g == 46 { v = "N" }
  if g == 47 { v = "O" }
  if g == 48 { v = "P" }
  if g == 49 { v = "Q" }
  if g == 50 { v = "R" }
  if g == 51 { v = "S" }
  if g == 52 { v = "T" }
  if g == 53 { v = "U" }
  if g == 54 { v = "V" }
  if g == 55 { v = "W" }
  if g == 56 { v = "X" }
  if g == 57 { v = "Y" }
  if g == 58 { v = "Z" }
  if g == 59 { v = "[" }
  if g == 61 { v = "]" }
  if g == 62 { v = "^" }
  if g == 63 { v = "_" }
  if g == 64 { v = "`" }
  if g == 65 { v = "a" }
  if g == 66 { v = "b" }
  if g == 67 { v = "c" }
  if g == 68 { v = "d" }
  if g == 69 { v = "e" }
  if g == 70 { v = "f" }
  if g == 71 { v = "g" }
  if g == 72 { v = "h" }
  if g == 73 { v = "i" }
  if g == 74 { v = "j" }
  if g == 75 { v = "k" }
  if g == 76 { v = "l" }
  if g == 77 { v = "m" }
  if g == 78 { v = "n" }
  if g == 79 { v = "o" }
  if g == 80 { v = "p" }
  if g == 81 { v = "q" }
  if g == 82 { v = "r" }
  if g == 83 { v = "s" }
  if g == 84 { v = "t" }
  if g == 85 { v = "u" }
  if g == 86 { v = "v" }
  if g == 87 { v = "w" }
  if g == 88 { v = "x" }
  if g == 89 { v = "y" }
  if g == 90 { v = "z" }
  if g == 92 { v = "|" }
  if g == 94 { v = "~" }
  v
}

fn cell_w(f: i32) -> i32 { if f == 0 { 20 } else if f == 1 { 24 } else { 40 } }
fn cell_h(f: i32) -> i32 { if f == 0 { 20 } else if f == 1 { 22 } else { 56 } }
fn size_of(f: i32) -> f32 { if f == 0 { 16.0 } else if f == 1 { 16.0 } else { 48.0 } }
fn row_y(f: i32) -> i32 { if f == 0 { 0 } else if f == 1 { 60 } else { 126 } }

system load() {
  Fonts.small = font("fonts/m5x7.ttf", 16)
  Fonts.head = font("fonts/Silkscreen-Bold.ttf", 16)
  Fonts.big = font("fonts/Jersey10-Regular.ttf", 48)
}

system draw() {
  for f in 0..3 {
    let id = if f == 0 { Fonts.small } else if f == 1 { Fonts.head } else { Fonts.big }
    for g in 0..95 {
      let x = (g % PER_ROW) * cell_w(f)
      let y = row_y(f) + (g / PER_ROW) * cell_h(f)
      let t = glyph(g)
      window::write("{t}", x as f32, y as f32, 200.0, id, size_of(f), 0.0, 0.0, 2, 0, 0xffffff)
      // The advance: a space as wide as an "n" (a space alone measures 0).
      let adv = if g == 0 { text_extent("n", id, size_of(f), 0.0, 2) } else { text_extent("{t}", id, size_of(f), 0.0, 2) }
      let a = (adv + 0.5) as i32
      rect((g * 1) as f32, (SHEET_H - 3 + f) as f32, 1.0, 1.0, (a << 16) | 0x0101)
    }
  }
  if Window.frame == 3 && !Fonts.shot {
    screenshot("card_glyphs.png")
    Fonts.shot = true
    put("card_glyphs.png: {SHEET_W} by {SHEET_H}")
  }
}

schedule start() { load() }
schedule frame() { begin()  draw()  present() }
main {
  start()
  loop { frame() } until Fonts.shot || Window.closed
}
