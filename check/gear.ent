// The tools and the matter they work on, on a course built for them,
// a station each (flat bedrock under all): one Pixalorien is put at a
// station, given an order, and two turns later what it did is counted.
//
//  1. blaster at sandstone       2. blaster at rock
//  3. blaster at bedrock         4. blaster at a gas pocket's wall
//  5. blaster into the gas       6. a charge at rock round bedrock
//  7. flamer at ice by wood      8. torch through 80 cells of rock
//  9. scan of rock with a lake in it nobody has seen
// 10. walking over crumbling rock over a pit
// 11. a flare thrown
//
// Pictures at the end of each (gear_<n>.png), and a digest of the
// cells at the end (the same on one core and on all). Run from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../check/gear.ent
import window
import console
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools

const FLOOR = 600
const PHASE = 600
const PHASES = 11

world {
  Window.width = 1440
  Window.height = 810
  Window.title = "Pixalorien tools check"
  Window.fps = 0
  Sim.run = true
  Places.seed = 1
  Sight.full = true
}

transient unique Watch { phase: i32, t0: f64, bolts: i32, broken: i32, cut: i32, x0: i32, y0: i32 }

system course() {
  fill(Cells, 0, FLOOR, W, H, Matter.Bedrock)
  // 1-3
  fill(Cells, 130, FLOOR - 30, 150, FLOOR, Matter.Sandstone)
  fill(Cells, 330, FLOOR - 30, 350, FLOOR, Matter.Rock)
  fill(Cells, 530, FLOOR - 30, 540, FLOOR, Matter.Bedrock)
  // 4-5: a box of rock, its near wall sandstone, full of gas
  fill(Cells, 730, FLOOR - 40, 800, FLOOR, Matter.Rock)
  fill(Cells, 730, FLOOR - 36, 733, FLOOR - 4, Matter.Sandstone)
  fill(Cells, 733, FLOOR - 36, 796, FLOOR - 4, Matter.Gas)
  // 6: rock round a post of bedrock
  fill(Cells, 940, FLOOR - 50, 990, FLOOR, Matter.Rock)
  fill(Cells, 958, FLOOR - 50, 962, FLOOR, Matter.Bedrock)
  // 7: ice, wood behind it
  fill(Cells, 1130, FLOOR - 20, 1150, FLOOR, Matter.Ice)
  fill(Cells, 1150, FLOOR - 20, 1156, FLOOR, Matter.Wood)
  // 8: rock to cut through
  fill(Cells, 1320, FLOOR - 30, 1400, FLOOR, Matter.Rock)
  // 9: rock with a lake in it
  fill(Cells, 1520, FLOOR - 40, 1590, FLOOR, Matter.Rock)
  fill(Cells, 1540, FLOOR - 30, 1570, FLOOR - 12, Matter.Water)
  // 10: a pit under a slab of crumbling rock
  fill(Cells, 1720, FLOOR, 1800, FLOOR + 30, Matter.Air)
  fill(Cells, 1716, FLOOR, 1804, FLOOR + 5, Matter.Crumble)
  Places.ship_x = 60
  Places.ship_y = FLOOR - 1
}

// Everything known, as it is, but station 9 (from x 1500 on).
system know_all() {
  for ch: Chunk, k: mut Known[ch.k << 12, CHUNK], fr: mut Fresh[ch.k, 1] {
    if ch.cx < 1500 / 64 {
      for i in 0..CHUNK {
        let r = (ch.k << 12) + i
        k[i].m = Cells[r].m
        k[i].shade = Cells[r].shade
        k[i].lit = 255
        k[i].stamp = 1
      }
    }
    fr[0].d = 1
  }
}

fn count(cells: Cells, x0: i32, y0: i32, x1: i32, y1: i32, m: Matter) -> i32 {
  var n = 0
  for x in x0..x1 {
    for y in y0..y1 {
      if cells[at(x, y)].m == m { n += 1 }
    }
  }
  n
}

proc digest(cells: Cells) -> u64 {
  var h: u64 = 1469598103934665603
  for i in 0..W * H {
    h = (h ^ (cells[i].m as u64 * 256 + cells[i].shade as u64)) * 1099511628211
  }
  h
}

fn station(k: i32) -> i32 {
  if k == 1 { 100 } else if k == 2 { 300 } else if k == 3 { 500 } else if k <= 5 { 700 } else if k == 6 { 905 }
  else if k == 7 { 1110 } else if k == 8 { 1316 } else if k == 9 { 1505 } else if k == 10 { 1700 } else { 100 }
}

// At the start of each phase: the first of the team put at its station,
// an order given; the others out of the way.
system stage() {
  if Sim.tick % PHASE == 0 && Watch.phase < PHASES {
    Watch.phase += 1
    let k = Watch.phase
    for p: mut Pixalorien {
      p.x = if p.id == 0 { station(k) } else { 1960 + p.id * 10 }
      p.y = FLOOR - 1
      p.t = 0
      p.len = 0
      p.k = 0
      p.fall = 0
      p.busy = false
      p.order = IDLE
      p.fuel = TANK
    }
    Orders[0].set = true
    Orders[0].gy = FLOOR - 4
    if k == 1 { Orders[0].order = SHOOT  Orders[0].gx = 131 }
    else if k == 2 { Orders[0].order = SHOOT  Orders[0].gx = 331 }
    else if k == 3 { Orders[0].order = SHOOT  Orders[0].gx = 531 }
    else if k == 4 { Orders[0].order = SHOOT  Orders[0].gx = 731  Orders[0].gy = FLOOR - 6 }
    else if k == 5 { Orders[0].order = SHOOT  Orders[0].gx = 750  Orders[0].gy = FLOOR - 6 }
    else if k == 6 { Orders[0].order = CHARGE  Orders[0].gx = 941  Orders[0].gy = FLOOR - 10 }
    else if k == 7 { Orders[0].order = FLAME  Orders[0].gx = 1131  Orders[0].gy = FLOOR - 8 }
    else if k == 8 { Orders[0].order = CUT  Orders[0].gx = 1404  Orders[0].gy = FLOOR - 1 }
    else if k == 9 { Orders[0].order = SCAN  Orders[0].gx = 1535  Orders[0].gy = FLOOR - 20 }
    else if k == 10 { Orders[0].order = GO  Orders[0].gx = 1850  Orders[0].gy = FLOOR - 1 }
    else { Orders[0].order = FLARE  Orders[0].gx = 160  Orders[0].gy = FLOOR - 40 }
    Watch.bolts = Tools.bolts
    Watch.broken = Tools.broken
    Watch.cut = Tools.cut
    Watch.t0 = wait_until(0.0)
  }
}

system aim_camera() {
  Camera.scale = 4.0
  Camera.x = station(Watch.phase) as f32 + 40.0 - Window.width as f32 / Camera.scale / 2.0
  Camera.y = FLOOR as f32 - 20.0 - Window.height as f32 / Camera.scale / 2.0
}

// At the end of each phase: what was done.
system tell() {
  if Sim.tick % PHASE == PHASE - 1 {
    let k = Watch.phase
    let bolts = Tools.bolts - Watch.bolts
    let broken = Tools.broken - Watch.broken
    for p: Pixalorien {
      if p.id == 0 {
        put("{k}: {order_name(p.order)} left, at {p.x},{p.y}; bolts {bolts}, broken {broken}, cut {Tools.cut - Watch.cut}")
        if k == 1 { put("   sandstone left {count(Cells, 130, FLOOR - 30, 150, FLOOR, Matter.Sandstone)} of 600") }
        else if k == 2 { put("   rock left {count(Cells, 330, FLOOR - 30, 350, FLOOR, Matter.Rock)} of 600") }
        else if k == 3 { put("   bedrock left {count(Cells, 530, FLOOR - 30, 540, FLOOR, Matter.Bedrock)} of 300") }
        else if k == 4 { put("   wall left {count(Cells, 730, FLOOR - 36, 733, FLOOR - 4, Matter.Sandstone)} of 96; gas {count(Cells, 733, FLOOR - 40, 796, FLOOR, Matter.Gas)}") }
        else if k == 5 { put("   gas left {count(Cells, 725, FLOOR - 60, 800, FLOOR, Matter.Gas)} of 2016; smoke {count(Cells, 700, FLOOR - 90, 800, FLOOR, Matter.Smoke)}") }
        else if k == 6 {
          put("   rock left {count(Cells, 940, FLOOR - 50, 990, FLOOR, Matter.Rock)} of 2300, bedrock {count(Cells, 958, FLOOR - 50, 962, FLOOR, Matter.Bedrock)} of 200, rubble {count(Cells, 900, FLOOR - 60, 1000, FLOOR, Matter.Rubble)}; charges left {p.charges}")
        } else if k == 7 {
          put("   ice left {count(Cells, 1130, FLOOR - 20, 1150, FLOOR, Matter.Ice)} of 400, wood {count(Cells, 1150, FLOOR - 20, 1156, FLOOR, Matter.Wood)} of 120, water {count(Cells, 1100, FLOOR - 20, 1160, FLOOR, Matter.Water)}")
        } else if k == 8 { put("   rock left in the way {count(Cells, 1320, FLOOR - 7, 1400, FLOOR, Matter.Rock)}") }
        else if k == 9 {
          let mid = at(1555, FLOOR - 20)
          put("   scanned {Tools.scanned}; the lake's middle known as {Known[mid].m as i32} (water {Matter.Water as i32})")
        } else if k == 10 {
          put("   crumble left {count(Cells, 1716, FLOOR, 1804, FLOOR + 5, Matter.Crumble)} of 440, rubble {count(Cells, 1700, FLOOR - 10, 1820, FLOOR + 30, Matter.Rubble)}")
        } else { put("   flares {count(Cells, 100, FLOOR - 60, 220, FLOOR, Matter.Flare)}, flares left {p.flares}") }
      }
    }
    screenshot("gear_{k}.png")
    if k == PHASES { put("digest of the cells {digest(Cells)}") }
  }
}

schedule setup() {
  course()
  wake_all()
  know_all()
  navigate()
  unfresh()
}
schedule tick() {
  begin()
  stage()
  take_orders()
  work()
  find_ways()
  move()
  tread()
  fly()
  clock()
  eyes()
  sight()
  navigate()
  unfresh()
  step()
  aim_camera()
  frame_picture()
  paint_view()
  draw_view()
  draw_team()
  draw_shots()
  draw_turn()
  tell()
  present()
}

main {
  setup()
  loop { tick() } until Sim.tick >= PHASES * PHASE
}
