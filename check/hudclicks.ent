// The HUD's clicks (hud.ent, turns.ent's command): seed 1 after the
// landing, the mouse moved and pressed by the check, a step every 6
// frames; after each, what it should have done is checked: a card
// chooses, the blaster's button tells its key (B) and gives no order, a
// click in the world sends the chosen there (not the blaster), the
// follow button tells T, a click on one of the team chooses it, the
// switch, the clock, the wait button, the charge's button told C and
// forgotten by the right button. A picture with B told and the mouse in
// the world (`build/shots/hud_told.png`). Run from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../check/hudclicks.ent
import window
import math
import console
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools
import creatures
import views
import world
import goal
import hud

const SETTLE = 600
const STEPS = 11
const EACH = 6

world {
  Window.width = 1440
  Window.height = 810
  Window.title = "Pixalorien HUD clicks check"
  Window.fps = 0
  Sim.run = true
  Places.seed = 1
  Plan.strategy = CAUTIOUS
}

transient unique Script { f: i32, k: i32, ok: i32, bad: i32, wx: f32, wy: f32 }

// Where step `k` puts the mouse, and whether it presses.
system fake_mouse() {
  let k = Script.k
  let t = Script.f % EACH
  let y0 = Window.height as f32 - STRIP as f32
  let py = y0 + 8.0
  let rx = right_x()
  let sw = switch_w(Window.width as f32 - rx - 8.0)
  let sx = (Feet[0].dx - Camera.x) * Camera.scale + Camera.ox
  let sy = (Feet[0].dy - 3.0 - Camera.y) * Camera.scale + Camera.oy
  var x = 0.0
  var y = 0.0
  if k == 0 { x = card_x(1) + 100.0  y = py + 50.0 }
  else if k == 1 { x = button_x(3) + 30.0  y = button_y(3, py) + 20.0 }
  else if k == 2 || k == 3 { x = sx + 60.0  y = sy }
  else if k == 4 { x = button_x(2) + 30.0  y = button_y(2, py) + 20.0 }
  else if k == 5 { x = sx  y = sy }
  else if k == 6 { x = rx + 12.0 + sw / 2.0  y = py + 70.0 }
  else if k == 7 { x = rx + 100.0  y = py + 36.0 }
  else if k == 8 { x = button_x(1) + 30.0  y = button_y(1, py) + 20.0 }
  else if k == 9 || k == 10 { x = button_x(5) + 30.0  y = button_y(5, py) + 20.0 }
  Mouse.x = x
  Mouse.y = y
  let presses = k != 2 && k != 10
  Mouse.left = presses && t >= 1 && t <= 2
  Mouse.right = k == 10 && t >= 1 && t <= 2
  if k == 3 && t == 0 {
    Script.wx = Camera.x + (x - Camera.ox) / Camera.scale
    Script.wy = Camera.y + (y - Camera.oy) / Camera.scale
  }
}

fn verdict(ok: bool) -> text[8] { if ok { "ok" } else { "FAIL" } }

system judge() {
  if Script.f % EACH == EACH - 1 {
    let k = Script.k
    var ok = false
    if k == 0 { ok = Pick.chosen == 2 }
    else if k == 1 { ok = Hud.told == SHOOT && Orders[1].order != SHOOT }
    else if k == 2 { ok = Hud.told == SHOOT }
    else if k == 3 {
      // (Given, and taken at the next tick: the row keeps what it was.)
      ok = Orders[1].order == GO
           && iabs(Orders[1].gx - Script.wx as i32) <= 1 && iabs(Orders[1].gy - Script.wy as i32) <= 1
    }
    else if k == 4 { ok = Hud.told == FOLLOW }
    else if k == 5 { ok = Pick.chosen == 1 && Orders[1].order != FOLLOW }
    else if k == 6 { ok = Choice.next == MANUAL }
    else if k == 7 { ok = !Play.run }
    else if k == 8 { ok = Orders[0].order == IDLE && Orders[0].set }
    else if k == 9 { ok = Hud.told == CHARGE }
    else { ok = Hud.told == 0 }
    if ok { Script.ok += 1 } else { Script.bad += 1 }
    put("step {k}: {verdict(ok)} (chosen {Pick.chosen}, told {Hud.told}, order of 1 {Orders[0].order}, of 2 {Orders[1].order} lead {Orders[1].lead}, next {Choice.next}, running {Play.run})")
    if k == 2 { screenshot("shots/hud_told.png") }
    Script.k += 1
  }
  Script.f += 1
}

system tell() { put("{Script.ok} of {STEPS} steps right, {Script.bad} wrong") }
system run_first() { Play.run = true }

schedule creatures_in() {
  populate()
  place_creatures()
}
schedule settle() { step() }
schedule setup() {
  load_fonts()
  disembark()
  new_loot()
  landed()
  eyes()
  sight()
  navigate()
  unfresh()
  run_first()
}
schedule frame() {
  begin()
  fake_mouse()
  live()
  steer()
  sum_chosen()
  time_clicks()
  strip_clicks()
  command()
  sim()
  alerts()
  arrange()
  a_view()
  a_view()
  a_view()
  point()
  paint_mini() run_if Window.frame % 15 == 0
  draw_mini()
  draw_box()
  draw_tip()
  draw_strip()
  draw_time()
  draw_goal()
  judge()
  present()
}
schedule done() { tell() }

main {
  make()
  creatures_in()
  loop { settle() } until Sim.tick == SETTLE
  setup()
  loop { frame() } until Script.k == STEPS || Window.closed
  done()
}
