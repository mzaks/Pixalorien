// The player's go for all three (as a click gives it, turns.ent's
// `go_there`), manual, seed 1 after the landing, the world kept
// running: six legs to places on the surface from the scout's (a click
// 3 cells over the ground). Each must end with all three there (their
// goals within SIDE_BY of each other's height: none sent to a cliff's
// foot or into a crack beside the place: each within SIDE_BY of the
// middle one), within 2400 ticks, and each
// one's first way no more than 1.3 times as far across as straight
// plus 40 (2026-10-31: before, one went down a cliff, and near the goal
// they went a long way round into the depths). Run from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../check/goals.ent
import window
import math
import console
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools
import creatures
import views
import world
import goal
import hud

const SETTLE = 600
const LEGS = 6

world {
  Window.width = 1440
  Window.height = 810
  Window.title = "Pixalorien goals check"
  Window.fps = 0
  Sim.run = true
  Places.seed = 1
  Plan.strategy = MANUAL
  Choice.next = MANUAL
}

transient unique Script { leg: i32, t: i32, seen: i32, gx: i32, gy: i32, x0: i32, idle: i32, n0: i32, n1: i32, n2: i32, bad: i32, lo: i32, hi: i32 }

fn offset(leg: i32) -> i32 {
  if leg == 0 { 80 } else if leg == 1 { 160 } else if leg == 2 { -100 } else if leg == 3 { 250 } else if leg == 4 { -200 } else { 120 }
}

system order() {
  if Script.t == 0 {
    let x = Feet[0].x + offset(Script.leg)
    let y = Ground[x].y - 3
    Script.gx = x
    Script.gy = y
    Script.seen = 0
    Script.n0 = 0
    Script.n1 = 0
    Script.n2 = 0
    Script.lo = H
    Script.hi = 0
    put("leg {Script.leg}: from {Feet[0].x},{Feet[0].y} {Feet[1].x},{Feet[1].y} {Feet[2].x},{Feet[2].y} to {x},{y} (ground {Ground[x].y})")
    go_there(Orders, Nav, 7, x, y)
  }
}

system watch_ways() {
  for p: Pixalorien in turn by p.id {
    let c = if p.id == 0 { Script.n0 } else if p.id == 1 { Script.n1 } else { Script.n2 }
    if p.planned == Sim.tick - 1 && p.order == GO && c < 6 {
      if p.id == 0 { Script.n0 += 1 } else if p.id == 1 { Script.n1 += 1 } else { Script.n2 += 1 }
      var lo = p.x
      var hi = p.x
      var top = p.y
      var bot = p.y
      var kinds: text[60] = ""
      var last = -1
      var travel = 0
      var px = p.x
      for j in 0..p.len {
        let n = Way[p.id * MAXWAY + j].n
        let x = n / H
        let y = n % H
        lo = min(lo, x)
        hi = max(hi, x)
        top = min(top, y)
        bot = max(bot, y)
        travel += iabs(x - px)
        px = x
        let k = Way[p.id * MAXWAY + j].kind as i32
        if k != last && len(kinds) < 50 { kinds = "{kinds}{k}" }
        last = k
      }
      let endn = Way[p.id * MAXWAY + max(0, p.len - 1)].n
      let first = c == 0
      let ok = !first || travel * 10 <= iabs(p.gx - p.x) * 13 + 400
      if !ok { Script.bad += 1 }
      if first {
        Script.lo = min(Script.lo, p.gy)
        Script.hi = max(Script.hi, p.gy)
      }
      var mark: text[12] = ""
      if !ok { mark = "TOO LONG " }
      put("  {p.id + 1} t{Script.t} at {p.x},{p.y}: {mark}goal {p.gx},{p.gy}; way {p.len} steps, across {travel} (straight {iabs(p.gx - p.x)}), x {lo}..{hi}, y {top}..{bot}, ends {endn / H},{endn % H}; kinds {kinds}")
    }
  }
}

system next_leg() {
  Script.t += 1
  Play.run = true
  Script.idle = 0
  for p: Pixalorien { if p.order == IDLE { Script.idle += 1 } }
  if Script.t > 20 && Script.idle == TEAM || Script.t > 2400 {
    let ok = Script.idle == TEAM && Script.hi - Script.lo <= 2 * SIDE_BY
    if !ok { Script.bad += 1 }
    for p: Pixalorien in turn by p.id { put("  {p.id + 1}: after {Script.t} ticks at {p.x},{p.y} order {p.order} stuck {p.stuck}") }
    var word: text[8] = "ok"
    if !ok { word = "WRONG" }
    put("  all there {Script.idle == TEAM}, goals' heights {Script.lo}..{Script.hi}: {word}")
    Script.leg += 1
    Script.t = 0
  }
}

system tell() { if Script.bad == 0 { put("goals ok") } else { put("goals: {Script.bad} WRONG") } }

schedule creatures_in() {
  populate()
  place_creatures()
}
schedule settle() { step() }
schedule setup() {
  load_fonts()
  disembark()
  new_loot()
  landed()
  eyes()
  sight()
  navigate()
  unfresh()
}
schedule frame() {
  begin()
  order()
  live()
  sim()
  watch_ways()
  next_leg()
  present()
}

schedule done() { tell() }

main {
  make()
  creatures_in()
  loop { settle() } until Sim.tick == SETTLE
  setup()
  loop { frame() } until Script.leg == LEGS || Window.closed
  done()
}
