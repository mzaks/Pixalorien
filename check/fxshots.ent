// The effects (effects.ent), pictured: seed 1, manual, the tech told to
// scan the rock under it; pictures `fx_*.png` in build/shots/: the scan
// at 30% and 80%, the sweep 8 and 22 ticks after it is done; then a
// creature's cry the team heard put beside the team and one far off to
// the right (outside the view), pictured 12 and 45 ticks after. Run
// from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../check/fxshots.ent
import window
import math
import console
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools
import creatures
import views
import world
import goal
import hud

const SETTLE = 600

world {
  Window.width = 1440
  Window.height = 810
  Window.title = "Pixalorien effects check"
  Window.fps = 0
  Sim.run = true
  Places.seed = 1
  Plan.strategy = MANUAL
}

// `step`: what was done (0 the scan ordered, then pictures 1 to 6);
// `cried`: the tick the cries were put in.
transient unique Script { step: i32, cried: i32, warm: i32, work: i32, done: bool }

system play() {
  Play.run = true
  Choice.next = MANUAL
}

system script() {
  Script.warm += 1
  let t = Sim.tick
  if Script.step == 0 && Script.warm == 30 {
    Orders[2].set = true
    Orders[2].auto = false
    Orders[2].order = SCAN
    Orders[2].gx = Feet[2].x + 4
    Orders[2].gy = Feet[2].y + 8
    Script.step = 1
    put("scan ordered at {Feet[2].x + 4},{Feet[2].y + 8}")
  }
  if Script.step == 4 && t - Tools.st == 40 {
    creatures::noise(Noises, 10, Feet[0].x + 30, Feet[0].y - 12, 300, t + 90, 1, true)
    creatures::noise(Noises, 11, Feet[0].x + 700, Feet[0].y + 60, 300, t + 90, 1, true)
    Script.cried = t
    Script.step = 5
  }
  if Script.step == 7 { Script.done = true }
}

system snap() {
  let t = Sim.tick
  Script.work = 0
  for p: Pixalorien in turn by p.id { if p.id == 2 && p.order == SCAN { Script.work += p.work } }
  let work = Script.work
  if Script.step == 1 && work == 90 {
    screenshot("shots/fx_scan_30.png")
    Script.step = 2
  } else if Script.step == 2 && work == 240 {
    screenshot("shots/fx_scan_80.png")
    Script.step = 3
  } else if Script.step == 3 && t - Tools.st == 8 {
    screenshot("shots/fx_scan_done_8.png")
    put("scan done at tick {Tools.st}: {Tools.scanned} cells")
  } else if Script.step == 3 && t - Tools.st == 22 {
    screenshot("shots/fx_scan_done_22.png")
    Script.step = 4
  } else if Script.step == 5 && t - Script.cried == 12 {
    screenshot("shots/fx_cry_12.png")
    Script.step = 6
  } else if Script.step == 6 && t - Script.cried == 45 {
    screenshot("shots/fx_cry_45.png")
    Script.step = 7
  }
}

system tell() { put("pictures taken: {Script.step - 1} of 6") }

schedule creatures_in() {
  populate()
  place_creatures()
}
schedule settle() { step() }
schedule setup() {
  load_fonts()
  disembark()
  new_loot()
  landed()
  eyes()
  sight()
  navigate()
  unfresh()
  fresh_turns()
}
schedule frame() {
  begin()
  play()
  live()
  steer()
  script()
  sim()
  alerts()
  arrange()
  a_view()
  a_view()
  a_view()
  point()
  paint_mini() run_if Window.frame % 15 == 0
  draw_mini()
  draw_strip()
  draw_time()
  snap()
  present()
}
schedule done() { tell() }

main {
  make()
  creatures_in()
  loop { settle() } until Sim.tick == SETTLE
  setup()
  loop { frame() } until Script.done || Sim.tick > SETTLE + 3000 || Window.closed
  done()
}
