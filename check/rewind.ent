// Going back, checked: the expedition of seed 1 with its creatures,
// cautious, played to turn END with a digest of the world as each turn
// begins (its cells, what the team knows, where the team and the
// creatures are, counts). Then three times back as R does it (to turn
// 12: its start in the ring; to 6: the kept start of 5 and a turn
// played again; to 3: the kept start of 0, as the ring holds later
// turns by then), each time played again to END; every turn's digest,
// in the quick passes and after, must be what it was. And what it
// costs: saving and loading a world, the file, the ticks a second of
// the quick passes. Run from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../check/rewind.ent
import window
import math
import console
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools
import creatures
import world
import goal

const SETTLE = 600
const END = 14

transient buffer Digests { h: u64 } capacity 64
transient unique Watch { over: bool, phase: i32, compared: i32, bad: i32, first_bad: i32, t0: f64, tick0: i32,
                         loads: f64, quick: f64, quick_ticks: i32 }

world {
  Digests = [{ h: 0 }; 64]
  Watch.first_bad = -1
  Watch.tick0 = -1
  Window.width = 640
  Window.height = 360
  Window.title = "Pixalorien rewind check"
  Window.fps = 0
  Sim.run = true
  Places.seed = 1
}

fn digest(cells: Cells, known: Known, feet: Feet, beasts: Beasts) -> u64 {
  var h: u64 = 1469598103934665603
  for r in 0..W * H {
    h = (h ^ (cells[r].m as i32) as u64) * 1099511628211
    if known[r].stamp != 0 { h = (h ^ ((known[r].m as i32) * 977 + r) as u64) * 1099511628211 }
  }
  for e in 0..TEAM { h = (h ^ (feet[e].x * 4096 + feet[e].y + (if feet[e].down { 1 << 30 } else { 0 })) as u64) * 1099511628211 }
  for j in 0..MOST { h = (h ^ ((beasts[j].x * 4096 + beasts[j].y) * 2 + (if beasts[j].alive { 1 } else { 0 })) as u64) * 1099511628211 }
  h
}

system timed_save() {
  Saved.file = "rewind_t.sav"
  Watch.t0 = wait_until(0.0)
}
system tell_save() { put("a world saved in {(wait_until(0.0) - Watch.t0) * 1000.0} ms (ok {Saved.ok})") }

system play() { Play.run = true }

system record() {
  let t = Turn.number
  let h = digest(Cells, Known, Feet, Beasts) ^ (Sim.tick as u64 * 31 + Fauna.harm as u64 * 7 + Routes.cut as u64 + (Tools.broken as u64 << 20))
  if Watch.phase == 0 { Digests[t].h = h } else {
    Watch.compared += 1
    if Digests[t].h != h {
      Watch.bad += 1
      if Watch.first_bad < 0 { Watch.first_bad = t }
      put("   turn {t}: digest {h}, was {Digests[t].h}")
    }
  }
}

// At END: back again, as R does it.
system rewind() {
  if Turn.number == END && Watch.phase == 3 { Watch.over = true }
  if Turn.number == END && Watch.phase < 3 {
    Watch.phase += 1
    Replay.target = if Watch.phase == 1 { 12 } else if Watch.phase == 2 { 6 } else { 3 }
    Replay.ask = true
  }
}

system tell_back() { put("back to turn {Replay.target}: loading the start of turn {Replay.from} ({Replay.file})") }
system load_on() { Watch.t0 = wait_until(0.0) }
system load_off() {
  let ms = (wait_until(0.0) - Watch.t0) * 1000.0
  Watch.loads += ms
  put("   loaded in {ms} ms (ok {Saved.ok}), at turn {Turn.number} tick {Turn.tick}")
  Watch.t0 = wait_until(0.0)
  Watch.tick0 = Sim.tick
}
system replayed() {
  if !Replay.on && Watch.tick0 >= 0 {
    let s = wait_until(0.0) - Watch.t0
    let n = Sim.tick - Watch.tick0
    Watch.quick += s
    Watch.quick_ticks += n
    put("   played again: {n} ticks in {s} s")
    Watch.tick0 = -1
  }
}

system tell() {
  put("compared {Watch.compared} turn starts after going back: {Watch.bad} differ (first {Watch.first_bad})")
  put("loads {Watch.loads / 3.0} ms each; quick passes {Watch.quick_ticks as f64 / max(Watch.quick, 0.001)} ticks a second")
}

schedule creatures_in() {
  populate()
  place_creatures()
}
schedule settle() { step() }
schedule setup() {
  disembark()
  new_loot()
  landed()
  eyes()
  sight()
  navigate()
  unfresh()
  timed_save()
  save_world()
  tell_save()
}
schedule frame() {
  begin()
  load_on() run_if Replay.load
  to_load() run_if Replay.load
  load_world() run_if Replay.load
  load_off() run_if Replay.load
  after_load() run_if Replay.load
  play()
  live()
  replayed()
  record() run_if Go.sim && Turn.tick == 0
  rewind() run_if Go.sim && Turn.tick == 0
  go_back() run_if Replay.ask
  tell_back() run_if Replay.load
  sim()
  present()
}
schedule quick() {
  fast()
  record() run_if Turn.tick == 0
  sim()
  replay_done()
}
schedule done() { tell() }

main {
  make()
  creatures_in()
  loop { settle() } until Sim.tick == SETTLE
  setup()
  loop {
    frame()
    loop { quick() } until !Replay.on || Replay.full || Window.closed
  } until Watch.over || Window.closed
  done()
}
