// The expedition of seed 1 (check/expedition.ent) with the creatures in
// the world: the team sent from the ship to the vault, knowing only the
// surface, in manual play (firing back only at what attacks it). Each turn: where each is and
// its armour, the creatures alive, hunting, killed, the attacks and harm
// done, and what the creatures cost a frame; pictures every 5 turns
// (hunted_<turn>.png) and a digest of where the team and the creatures
// end (the same on one core and on all). Run from build/:
//   ENT_PARALLEL_MIN=64 ../../ent-lang/tools/ent run --parallel -I .. ../check/hunted.ent
import window
import math
import console
import clock
import matter
import gen
import view
import sight
import team
import turns
import tools
import creatures

const SETTLE = 600
const TURNS = 40

world {
  Window.width = 1440
  Window.height = 810
  Window.title = "Pixalorien hunted check"
  Window.fps = 0
  Sim.run = true
  Places.seed = 1
  Plan.strategy = MANUAL
}

transient unique Watch { t1: f64, beasts: f64, most: f64, frames: i32, last: i32 }

system send() {
  for e in 0..TEAM {
    Orders[e].set = true
    Orders[e].order = GO
    Orders[e].gx = Places.vault_x - Places.side * (14 + e * 6)
    Orders[e].gy = Places.vault_y
  }
  Pick.chosen = 7
}

system t_on() { Watch.t1 = wait_until(0.0) }
system t_off() {
  let ms = (wait_until(0.0) - Watch.t1) * 1000.0
  Watch.beasts += ms
  Watch.most = max(Watch.most, ms)
  Watch.frames += 1
}

fn down_mark(d: bool) -> text[8] { if d { " DOWN" } else { "" } }

system report() {
  if (Now.tick / LEG) != Watch.last {
    Watch.last = (Now.tick / LEG)
    var alive = 0
    var hunting = 0
    for j in 0..MOST {
      if Beasts[j].alive {
        alive += 1
        if Beasts[j].state == HUNT { hunting += 1 }
      }
    }
    for p: Pixalorien in turn by p.id {
      put("turn {(Now.tick / LEG)} {p.id + 1}: at {p.x},{p.y} order {p.order} armour {p.hp}{down_mark(p.down)}")
    }
    put("   creatures {alive} alive, {hunting} hunting, {Fauna.killed} killed; hunts {Fauna.hunts}, attacks {Fauna.attacks}, harm {Fauna.harm}, knocks {Fauna.knocks}, spits {Fauna.spits}, dug {Fauna.dug}, bolts back {Fauna.guards}; a frame {Watch.beasts / max(1, Watch.frames) as f64} ms (most {Watch.most})")
    Watch.beasts = 0.0
    Watch.most = 0.0
    Watch.frames = 0
  }
}

system aim_camera() {
  Camera.scale = 2.0
  Camera.x = Feet[0].dx - Window.width as f32 / Camera.scale / 2.0
  Camera.y = Feet[0].dy - Window.height as f32 / Camera.scale / 2.0
}

system snap_pic() {
  if (Now.tick % LEG) == 1 && (Now.tick / LEG) % 5 == 0 { screenshot("hunted_{(Now.tick / LEG)}.png") }
}

system tally() {
  var h: u64 = 1469598103934665603
  for e in 0..TEAM { h = (h ^ (Feet[e].x * 4096 + Feet[e].y) as u64) * 1099511628211 }
  for j in 0..MOST {
    h = (h ^ ((Beasts[j].x * 4096 + Beasts[j].y) * 2 + (if Beasts[j].alive { 1 } else { 0 })) as u64) * 1099511628211
  }
  put("digest of where they are {h}; searches {Routes.search}")
  for c: Creature in turn by c.id {
    if c.id < Fauna.placed { put("  {c.id}: kind {c.kind as i32} alive {c.alive} at {c.x},{c.y} home {c.hx},{c.hy} state {c.state} hp {c.hp} stuck {c.stuck} in {Cells[at(c.x, c.y)].m as i32}") }
  }
}

schedule settle() { step() }
schedule done() { tally() }
schedule creatures_in() {
  populate()
  place_creatures()
}
schedule setup() {
  disembark()
  landed()
  eyes()
  sight()
  navigate()
  unfresh()
  send()
}
schedule tick() {
  begin()
  step()
  take_orders()
  work()
  guard()
  find_ways()
  move()
  tread()
  bolt_hits()
  fly()
  listen()
  t_on()
  prowl()
  t_off()
  spit_fly()
  harm()
  wounds()
  clock()
  eyes()
  sight()
  navigate()
  unfresh()
  report()
  aim_camera()
  frame_picture()
  paint_view()
  draw_view()
  draw_team()
  draw_shots()
  draw_creatures()
  draw_turn()
  snap_pic()
  present()
}

main {
  make()
  creatures_in()
  loop { settle() } until Sim.tick == SETTLE
  setup()
  loop { tick() } until (Now.tick / LEG) == TURNS || Window.closed
  done()
}
