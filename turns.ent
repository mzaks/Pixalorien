// Time and orders.
//
// Time runs a tick at a time (60 a second) from the landing; Space
// pauses and goes on, `,` and `.` run it slower and faster (1, 2, 4
// times). Orders take effect at the tick after they are given (they
// can be given while paused).
//
// Orders: 1, 2, 3 choose one (with Shift, add or take away), 4 all; a
// left click on one of them chooses it (Shift adds), on the world sends
// the chosen there (go); T with the mouse on one of the team: the chosen
// follow it; H: the chosen wait where they are. With the mouse on a
// place: B the chosen fire their blasters at it, E their flamers, X cut
// toward it with the torch, Q scan it; C the first chosen throws a
// charge there, F a flare. V shows the whole world.
//
// Strategies: F5 manual, F6 cautious, F7 brute force (at once). In the
// two the autopilot gives each Pixalorien without an order of the
// player's its order, every second (`autopilot`).
//
// The game as it stands: every order the player gave and every change
// of strategy, with its tick (`OrderLog`, from the landing on), and the
// furthest tick played (`Line.reach`). The world is saved at the
// landing and every KEEP_EVERY ticks for good (`Kept`), and every
// RING_EVERY ticks in a ring of RING (`Ring`). Going to a tick
// (`Replay`): forward, the world is played quickly to it; back, as far
// as the undo log goes (journal.ent), it is taken back a tick at a
// time, and before that the saved world at or before it is loaded and
// played quickly to it; the log's orders are given again on their
// ticks. Backspace plays the world backwards (`Back`). Behind the reach the log
// plays (watching the game again); an order given or a strategy chosen
// there drops the rest of the log (and the saved worlds after it), and
// the game goes on from there. R goes back RING_EVERY ticks, Shift+R
// KEEP_EVERY; Home to the landing, End to the reach; Backspace plays
// backwards, or stops doing so.
import window
import clock
import math
import matter
import gen
import view
import sight
import team
import tools
import creatures
import world

const SECOND = 60
const LEG = 300                 // the cautious scout's trail: a point every five seconds
const BEAT = 60                 // the autopilot decides every second
const RING_EVERY = 300
const RING = 6
const KEEP_EVERY = 1800
const KEEPS = 256
const LOGS = 16384
const MAXLEGS = 512

// `tick`: ticks since the landing.
unique Now { tick: i32 }
// The orders for the next tick: whether one is given, what, where to,
// whom to follow; `auto`: the autopilot's.
buffer Orders { set: bool, order: i32, gx: i32, gy: i32, lead: i32, auto: bool } capacity 3
// Who is chosen (a bit each), and keys held last frame. (An order with
// a place is given by its key, where the mouse points; a click in the
// world sends the chosen there.)
transient unique Pick { chosen: i32, was_left: bool, was_t: bool, was_h: bool, was_f: bool, was_v: bool,
                        was_b: bool, was_e: bool, was_c: bool, was_x: bool, was_q: bool, was_r: bool, was_g: bool,
                        was_home: bool, was_end: bool, was_rew: bool, was_slow: bool, was_fast: bool,
                        pressing: bool, px: f32, py: f32, cx: f32, cy: f32, cs: f32, cox: f32, coy: f32 }

// The player's orders (`who` one of the team) and strategies (`who`
// -1, the strategy in `order`), by tick, in the order given.
transient buffer OrderLog { tick: i32, who: i32, order: i32, gx: i32, gy: i32, lead: i32 } capacity 16384
// The tick each file of the ring holds (-1: none); whether the kept
// file of k * KEEP_EVERY is there.
transient buffer Ring { tick: i32 } capacity 6
transient buffer Kept { ok: bool } capacity 256
// The strategy chosen; the game's furthest tick (`reach`), its log's
// rows (`rows`), the next row to give again (`next`), the tick saved
// last (`saved`; `save`: to save now).
transient unique Choice { next: i32 }
transient unique Line { reach: i32, rows: i32, next: i32, saved: i32, save: bool }
// Going back by the undo log (journal.ent): whether it is begun from
// the world as it is (`ready`; a world loaded or made anew is not), the
// earliest tick it goes back to (`floor`); going to `Replay.target` by
// it (`on`), playing backwards at the speed chosen (`play`), the ticks
// still to go back in this frame (`left`), whether a pass goes back a
// tick (`go`).
transient unique Back { ready: bool, floor: i32, on: bool, play: bool, left: i32, go: bool }
// Going to tick `target` (`ask`: asked for now; `run`: play on from
// there, else paused): a saved world to load (`load`, of tick `from`,
// from `file`), then played quickly (`on`), `burst` ticks in this
// frame, begun at `t0`, `full` when it has taken its time (50 ms);
// `failed`: a saved world could not be read.
transient unique Replay { ask: bool, load: bool, on: bool, run: bool, from: i32, target: i32, burst: i32, failed: bool,
                          file: text[126], t0: f64, full: bool }
// Marks on the timeline (`Pins`): where one of the team went down, where the
// game paused itself, where a catastrophe came (`kind`; `who` the one
// it was about, -1 none), as the game stands; `down`: who was down
// last tick (a bit each).
const MARK_DOWN = 1
const MARK_PAUSE = 2
const MARK_DISASTER = 3
const MARKS = 1024
transient buffer Pins { tick: i32, kind: i32, who: i32 } capacity 1024
transient unique Marked { n: i32, down: i32 }
// The game stopping by itself (alarms.ent): the kinds of event, which
// of them stop it (`Pauses.on`, a bit each; `quiet`: none, in the
// tutorial until it teaches them), and the card shown (`Alarm`: what
// happened, to whom, at what tick).
const EV_HUNTED = 0
const EV_HURT = 1
const EV_FALL = 2
const EV_DOWN = 3
const EV_IDLE = 4
const EV_DANGER = 5
const EV_LOOT = 6
const EV_DISASTER = 7
const EVENTS = 8
transient unique Pauses { on: i32, quiet: bool }
transient unique Alarm { on: bool, kind: i32, who: i32, tick: i32, what: i32 }
// Whether this pass of the steps is the world's own (the frame's, a
// faster speed's further passes, the quick passes going to a tick).
transient unique Go { sim: bool }

// Whether the world is behind the game's reach (the log plays).
fn watching(tick: i32, reach: i32) -> bool { tick < reach }

// A frame: the world runs if the player lets it and it is not going to
// a tick; at a faster speed, `Play.left` more passes. Playing backwards
// stops when it runs; going back, `Back.left` passes back.
system live() {
  if Play.run { Back.play = false }
  Back.left = if Back.on { 1000000 } else if Back.play { Play.speed } else { 0 }
  Go.sim = !Replay.on && !Back.on && Game.over == 0
  Sim.run = Play.run && !Replay.on && !Back.on && Game.over == 0
  Play.left = if Sim.run { Play.speed - 1 } else { 0 }
  Replay.burst = 0
  Replay.t0 = wait_until(0.0)
  Replay.full = false
}
// A further pass: going to a tick, or a faster speed's.
system fast() {
  let more = !Replay.on && Play.left > 0 && Play.run && Game.over == 0
  Go.sim = Replay.on || more
  Sim.run = Replay.on || more
  if more { Play.left -= 1 }
  if !Play.run || Game.over != 0 { Play.left = 0 }
  Replay.burst += 1
  Replay.full = wait_until(0.0) - Replay.t0 > 0.05
}

// Saved as a tick begins, at the reach only (behind it, the files are
// there).
system checkpoint() {
  let t = Now.tick
  if t % RING_EVERY == 0 && t == Line.reach && Line.saved != t {
    Line.saved = t
    if t % KEEP_EVERY == 0 {
      Saved.file = "pix_k{t / KEEP_EVERY}.sav"
      Kept[min(t / KEEP_EVERY, KEEPS - 1)].ok = t / KEEP_EVERY < KEEPS
    } else {
      let r = (t / RING_EVERY) % RING
      Saved.file = "pix_r{r}.sav"
      Ring[r].tick = t
    }
    Line.save = true
  }
}
system saved() { Line.save = false }

// Behind the reach, an order of the player's or a strategy chosen: the
// rest of the game is dropped (the log from here, the saved worlds
// after this tick).
system branch() {
  var given = Choice.next != Plan.strategy
  for e in 0..TEAM { if Orders[e].set && !Orders[e].auto { given = true } }
  if given {
    let t = Now.tick
    Line.reach = t
    var n = Line.next
    while n > 0 && OrderLog[n - 1].tick >= t { n -= 1 }
    Line.rows = n
    Line.next = n
    while Marked.n > 0 && Pins[Marked.n - 1].tick > t { Marked.n -= 1 }
    for r in 0..RING { if Ring[r].tick > t { Ring[r].tick = -1 } }
    for k in 0..KEEPS { if k * KEEP_EVERY > t { Kept[k].ok = false } }
  }
}

// Behind the reach: the log's orders of this tick given again.
system replay_orders() {
  let t = Now.tick
  while Line.next < Line.rows && OrderLog[Line.next].tick < t { Line.next += 1 }
  while Line.next < Line.rows && OrderLog[Line.next].tick == t {
    let r = Line.next
    let who = OrderLog[r].who
    if who < 0 {
      Plan.strategy = OrderLog[r].order
      Choice.next = OrderLog[r].order
    } else {
      Orders[who].set = true
      Orders[who].auto = false
      Orders[who].order = OrderLog[r].order
      Orders[who].gx = OrderLog[r].gx
      Orders[who].gy = OrderLog[r].gy
      Orders[who].lead = OrderLog[r].lead
    }
    Line.next += 1
  }
}

// At the reach: the player's orders of this tick, and the strategy
// chosen, logged.
proc log_one(log: mut OrderLog, n: i32, t: i32, who: i32, order: i32, gx: i32, gy: i32, lead: i32) {
  log[n].tick = t
  log[n].who = who
  log[n].order = order
  log[n].gx = gx
  log[n].gy = gy
  log[n].lead = lead
}
system log_orders() {
  let t = Now.tick
  if Choice.next != Plan.strategy {
    Plan.strategy = Choice.next
    if Line.rows < LOGS {
      log_one(OrderLog, Line.rows, t, -1, Choice.next, 0, 0, 0)
      Line.rows += 1
    }
  }
  for e in 0..TEAM {
    if Orders[e].set && !Orders[e].auto && Line.rows < LOGS {
      log_one(OrderLog, Line.rows, t, e, Orders[e].order, Orders[e].gx, Orders[e].gy, Orders[e].lead)
      Line.rows += 1
    }
  }
  Line.next = Line.rows
}

// A mark on the timeline, at the reach only (behind it, it is there).
proc mark(pins: mut Pins, n: i32, t: i32, kind: i32, who: i32) {
  pins[n].tick = t
  pins[n].kind = kind
  pins[n].who = who
}
system mark_downs() {
  var now = 0
  for e in 0..TEAM { if Feet[e].down { now = now | (1 << e) } }
  let fresh = now & ~Marked.down
  if fresh != 0 && Now.tick >= Line.reach {
    for e in 0..TEAM {
      if fresh & (1 << e) != 0 && Marked.n < MARKS {
        mark(Pins, Marked.n, Now.tick, MARK_DOWN, e)
        Marked.n += 1
      }
    }
  }
  Marked.down = now
}

// Going to `Replay.target`: forward, played quickly from here; back, by
// the undo log as far as it goes, else the saved world at or before it
// (a kept one, or one in the ring after it) loaded first.
system go_back() {
  let target = max(0, min(Replay.target, Line.reach))
  Replay.target = target
  Replay.ask = false
  // No tick of the world in this frame (it would save over the file to
  // load, or play past the target).
  Go.sim = false
  Sim.run = false
  Play.left = 0
  Back.play = false
  Back.on = false
  if target >= Now.tick {
    Replay.on = target > Now.tick
    if !Replay.on { Play.run = Replay.run }
  } else if Back.ready && target >= Back.floor {
    Back.on = true
  } else {
    var k = min(target / KEEP_EVERY, KEEPS - 1)
    while k > 0 && !Kept[k].ok { k -= 1 }
    var from = k * KEEP_EVERY
    var ring = -1
    for r in 0..RING {
      let t = Ring[r].tick
      if t >= 0 && t <= target && t > from {
        from = t
        ring = r
      }
    }
    if ring >= 0 { Replay.file = "pix_r{ring}.sav" } else { Replay.file = "pix_k{k}.sav" }
    Replay.from = from
    Replay.load = true
  }
}

// (Named only now: the tick's own saving may name its file before.)
system to_load() { Saved.file = Replay.file }

system after_load() {
  Replay.load = false
  Back.ready = false
  Replay.failed = !Saved.ok
  Replay.on = Saved.ok && Now.tick < Replay.target
  Line.saved = Now.tick
  Line.next = 0
  Choice.next = Plan.strategy
  var down = 0
  for e in 0..TEAM { if Feet[e].down { down = down | (1 << e) } }
  Marked.down = down
  if !Replay.on { Play.run = Replay.run }
}

system replay_done() {
  if Replay.on && Now.tick >= Replay.target {
    Replay.on = false
    Play.run = Replay.run
  }
}

// A new world: time from 0, an empty log, no saved worlds.
system fresh_turns() {
  Now.tick = 0
  Line.reach = 0
  Line.rows = 0
  Line.next = 0
  Line.saved = -1
  Choice.next = Plan.strategy
  Plan.turn = -1
  Plan.backed = -100
  Plan.safe = 0
  Replay.on = false
  Back.ready = false
  Back.on = false
  Back.play = false
  Marked.n = 0
  Marked.down = 0
  for i in 0..RING { Ring[i].tick = -1 }
  for k in 0..KEEPS { Kept[k].ok = false }
}

// The autopilot (cautious and brute force), every BEAT ticks: an order
// for each Pixalorien that has none of the player's (one given holds
// until it is done; a wait until another is given), when it is not
// doing that already. The goal is beside the treasure. Brute force: all
// go there. Cautious: the first of the team still up is the scout and
// goes there; the others follow its trail (a point every LEG ticks), the
// next one a leg behind it, the last two (a leg more when it found no way there), and
// go to the goal once it is there; a scout with no way scans the rock
// toward the goal (cutting goes only through what is known); with a
// creature hunting near any of them, all back off for a leg to where
// the scout was before it came, then go on.
fn goal_x(id: i32, vx: i32, side: i32) -> i32 { vx - side * (14 + id * 6) }

system autopilot() {
  var scout = -1
  for e in 0..TEAM { if scout < 0 && !Feet[e].down { scout = e } }
  let leg = Now.tick / LEG
  let now = min(leg, MAXLEGS - 1)
  if scout >= 0 && Plan.turn != leg {
    let stands = (Nav[at(Feet[scout].x, Feet[scout].y)].b as i32 & STAND) != 0
    Trail[now].x = if stands || now == 0 { Feet[scout].x } else { Trail[now - 1].x }
    Trail[now].y = if stands || now == 0 { Feet[scout].y } else { Trail[now - 1].y }
    Plan.turn = leg
  }
  var danger = false
  for j in 0..MOST {
    if Beasts[j].alive && Beasts[j].state == HUNT {
      for e in 0..TEAM {
        if !Feet[e].down && max(iabs(Beasts[j].x - Feet[e].x), iabs(Beasts[j].y - Feet[e].y)) <= 60 { danger = true }
      }
    }
  }
  // Back off for a leg, then go on (and fight when cornered).
  if !danger { Plan.safe = now }
  if danger && leg - Plan.backed > 3 { Plan.backed = leg }
  let retreat = danger && Plan.backed == leg
  let back = if Plan.safe < now { Plan.safe } else { max(0, now - 1) }
  let side = Places.side
  let vy = Places.vault_y
  let scout_there = scout >= 0 && iabs(Feet[scout].x - goal_x(scout, Places.vault_x, side)) <= 3
                    && iabs(Feet[scout].y - vy) <= 8
  // Homeward, once one of them is by the treasure: the one nearest lifts
  // it (`bearer`), and all go to the ship. Cautious: the first of the
  // others ahead (to see the way), the last behind the carrier.
  var bearer = -1
  var nearest = 1000000
  var reached = Loot.lifted
  for e in 0..TEAM {
    if !Feet[e].down {
      let d = max(iabs(Feet[e].x - Loot.x), iabs(Feet[e].y - Loot.y))
      // (Its place beside the treasure is up to 26 cells from it.)
      if d <= 40 { reached = true }
      if d < nearest {
        nearest = d
        bearer = e
      }
    }
  }
  var ahead = -1
  var behind = -1
  for e in 0..TEAM {
    if !Feet[e].down && e != Loot.by && e != bearer {
      if ahead < 0 { ahead = e } else { behind = e }
    }
  }
  let carrier = if Loot.by >= 0 { Loot.by } else { bearer }
  for p: Pixalorien in turn by p.id {
    if !p.down && !Orders[p.id].set && !p.mine && !(tool(p.order) && p.order != SCAN) {
      let gx = goal_x(p.id, Places.vault_x, side)
      let there = iabs(p.x - gx) <= 3 && iabs(p.y - vy) <= 8
      var o = -1
      var ox = gx
      var oy = vy
      var lead = 0
      // Beside the ship, on the side the carrier is on (it cannot fly
      // over the hull).
      let near_side = if carrier >= 0 && Feet[carrier].x < Places.ship_x { -1 } else { 1 }
      let shipx = Places.ship_x + near_side * (50 + p.id * 8)
      let shipy = Places.ship_y
      // After a rough landing the tech stays by the ship and repairs it
      // first (homeward all go there anyway).
      if Hull.damage > 0 && p.id == TECH && !reached && p.id != scout {
        if iabs(p.x - Places.ship_x) <= REPAIR_NEAR - 10 && iabs(p.y - shipy) <= 20 {
          if p.order != IDLE { o = IDLE }
        } else {
          o = GO
          ox = shipx
          oy = shipy
        }
      } else if reached {
        if Loot.by < 0 && p.id == bearer {
          if p.order != CARRY { o = CARRY }
        } else if Loot.by < 0 {
          // Waiting by it for the carrier to lift it.
          o = GO
          ox = Loot.x - side * (16 + p.id * 6)
          oy = Loot.y
          if iabs(p.x - ox) <= 8 && iabs(p.y - oy) <= 8 { o = -1 }
        } else if Plan.strategy == CAUTIOUS && p.id == behind && carrier >= 0 {
          if !(p.order == FOLLOW && p.lead == carrier) {
            o = FOLLOW
            lead = carrier
          }
        } else {
          o = GO
          ox = shipx
          oy = shipy
        }
      } else if Plan.strategy == BRUTE {
        if !there { o = GO }
      } else if retreat && !there {
        o = GO
        ox = Trail[back].x
        oy = Trail[back].y
        if iabs(p.x - ox) <= 6 && iabs(p.y - oy) <= 8 { o = -1 }
      } else if p.id == scout {
        if p.stuck && p.order == GO {
          // Listen to the rock toward the goal.
          let ex = p.x as f32 + 0.5
          let ey = p.y as f32 - 4.5
          let dx = gx as f32 - ex
          let dy = vy as f32 - ey
          let d = max(sqrt(dx * dx + dy * dy), 1.0)
          o = SCAN
          ox = (ex + dx / d * 14.0) as i32
          oy = (ey + dy / d * 14.0) as i32
        } else if !there && p.order != SCAN { o = GO }
      } else if scout_there {
        if !there { o = GO }
      } else {
        // Its place behind the scout.
        var r = 1
        for e in 0..p.id { if e != scout && !Feet[e].down { r += 1 } }
        if p.stuck { r += 1 }
        let k = max(0, now - r)
        o = GO
        ox = Trail[k].x
        oy = Trail[k].y
        if iabs(p.x - ox) <= 3 && iabs(p.y - oy) <= 3 { o = -1 }
      }
      // Not again what it is doing.
      if o == GO && p.order == GO && p.gx == max(1, min(W - 2, ox)) && p.cy == oy { o = -1 }
      if o == SCAN && p.order == SCAN { o = -1 }
      if o >= 0 {
        Orders[p.id].set = true
        Orders[p.id].auto = true
        Orders[p.id].lead = lead
        Orders[p.id].order = o
        Orders[p.id].gx = ox
        Orders[p.id].gy = oy
      }
    }
  }
}

system take_orders() {
  for p: mut Pixalorien, o: mut Orders[p.id, 1] {
    if o[0].set && p.down { o[0].set = false }
    if o[0].set {
      // The player's (not the autopilot's) holds until it is done.
      p.mine = !o[0].auto
      o[0].auto = false
      p.order = o[0].order
      p.lead = o[0].lead
      p.busy = false
      if tool(p.order) {
        p.tx = o[0].gx
        p.ty = o[0].gy
      }
      // To carry: to the treasure.
      let ox = if p.order == CARRY { if Loot.lifted { Loot.x } else { Loot.x - Places.side * 10 } } else { o[0].gx }
      let oy = if p.order == CARRY { Loot.y } else { o[0].gy }
      if p.order == GO || p.order == CARRY || tool(p.order) {
        let y = snap_for(Nav, ox, oy, p.mine)
        p.gx = max(1, min(W - 2, ox))
        p.cy = oy
        p.gy = if y >= 0 { y } else { oy }
      }
      p.due = p.order != IDLE
      // A step under way is finished first (its target is the way's
      // row `k`); the new way is searched from where it ends.
      if p.t == 0 {
        p.len = 0
        p.k = 0
      }
      p.planned = -1000
      o[0].set = false
    }
  }
}

system clock() {
  Now.tick += 1
  if Now.tick > Line.reach { Line.reach = Now.tick }
}

// The chosen sent where the player clicked: side by side, each a few
// cells from the next, where that is on the same ground as the place
// clicked (feet within SIDE_BY of it) and seen; else to the place itself (one
// beside it past a cliff's edge or over a crack went to the foot of
// the cliff, into the crack).
const SIDE_BY = 3
proc go_there(orders: mut Orders, nav: Nav, chosen: i32, x: i32, y: i32) {
  let mid = snap_near(nav, x, y)
  for e in 0..TEAM {
    if chosen & (1 << e) != 0 {
      let bx = x + (e - 1) * 6
      let by = snap_near(nav, bx, y)
      let beside = mid >= 0 && by >= 0 && iabs(by - mid) <= SIDE_BY && nb(nav, bx, by) & MIST == 0
      orders[e].set = true
      orders[e].order = GO
      orders[e].gx = if beside { bx } else { x }
      orders[e].gy = if beside { by } else if mid >= 0 { mid } else { y }
    }
  }
}

// Which of the team the mouse is on (-1: none).
// An order with a tool for the chosen (only the first of them, `one`).
proc give(orders: mut Orders, chosen: i32, order: i32, x: i32, y: i32, one: bool) {
  var given = false
  for e in 0..TEAM {
    if chosen & (1 << e) != 0 && !(one && given) {
      orders[e].set = true
      orders[e].order = order
      orders[e].gx = x
      orders[e].gy = y
      given = true
    }
  }
}

fn under_mouse(mx: f32, my: f32, x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32) -> i32 {
  if abs(mx - x0) <= 2.5 && my >= y0 - 2.0 && my <= y0 + 6.0 { 0 }
  else if abs(mx - x1) <= 2.5 && my >= y1 - 2.0 && my <= y1 + 6.0 { 1 }
  else if abs(mx - x2) <= 2.5 && my >= y2 - 2.0 && my <= y2 + 6.0 { 2 }
  else { -1 }
}

system command() {
  let shift = key_down(340) || key_down(344)
  for e in 0..TEAM {
    if key_down('1' as i32 + e) {
      Pick.chosen = if shift { Pick.chosen | (1 << e) } else { 1 << e }
    }
  }
  if key_down('4' as i32) { Pick.chosen = 7 }
  // Where the mouse points, in the view it is in.
  let wx = Camera.x + (Mouse.x - Camera.ox) / Camera.scale
  let wy = Camera.y + (Mouse.y - Camera.oy) / Camera.scale
  let on_mini = on_map(Mouse.x, Mouse.y, Window.width)
  let who = under_mouse(wx, wy, Team[0].x, Team[0].y, Team[1].x, Team[1].y, Team[2].x, Team[2].y)
  // The left button: a click (on one of the team: chosen; elsewhere:
  // the chosen sent there) or, dragged, a box: those in it chosen.
  if Mouse.left && !Pick.was_left && !on_mini && !Alarm.on && Mouse.y < Window.height as f32 - Strip.h && !shielded(Mouse.x, Mouse.y, Shield.x, Shield.y, Shield.w, Shield.h) {
    Pick.pressing = true
    Pick.px = Mouse.x
    Pick.py = Mouse.y
    Pick.cx = Camera.x
    Pick.cy = Camera.y
    Pick.cs = Camera.scale
    Pick.cox = Camera.ox
    Pick.coy = Camera.oy
  }
  if !Mouse.left && Pick.pressing {
    Pick.pressing = false
    // In the view it was pressed in.
    let ax = Pick.cx + (Pick.px - Pick.cox) / Pick.cs
    let ay = Pick.cy + (Pick.py - Pick.coy) / Pick.cs
    let bx = Pick.cx + (Mouse.x - Pick.cox) / Pick.cs
    let by = Pick.cy + (Mouse.y - Pick.coy) / Pick.cs
    if max(abs(Mouse.x - Pick.px), abs(Mouse.y - Pick.py)) >= 6.0 {
      var box = 0
      for e in 0..TEAM {
        let x = Feet[e].dx
        let y = Feet[e].dy - 3.0
        if x >= min(ax, bx) - 2.0 && x <= max(ax, bx) + 2.0 && y >= min(ay, by) - 4.0 && y <= max(ay, by) + 4.0 {
          box = box | (1 << e)
        }
      }
      if box != 0 || !shift { Pick.chosen = if shift { Pick.chosen | box } else { box } }
    } else {
      let one = under_mouse(ax, ay, Team[0].x, Team[0].y, Team[1].x, Team[1].y, Team[2].x, Team[2].y)
      if one >= 0 {
        Pick.chosen = if shift { Pick.chosen | (1 << one) } else { 1 << one }
      } else {
        go_there(Orders, Nav, Pick.chosen, ax as i32, ay as i32)
      }
    }
  }
  Pick.was_left = Mouse.left
  let t = key_down('T' as i32)
  if t && !Pick.was_t && who >= 0 {
    for e in 0..TEAM {
      if Pick.chosen & (1 << e) != 0 && e != who {
        Orders[e].set = true
        Orders[e].order = FOLLOW
        Orders[e].lead = who
      }
    }
  }
  Pick.was_t = t
  let h = key_down('H' as i32)
  if h && !Pick.was_h {
    for e in 0..TEAM {
      if Pick.chosen & (1 << e) != 0 {
        Orders[e].set = true
        Orders[e].order = IDLE
      }
    }
  }
  Pick.was_h = h
  let mx = wx as i32
  let my = wy as i32
  let f = key_down('F' as i32)
  if f && !Pick.was_f { give(Orders, Pick.chosen, FLARE, mx, my, true) }
  Pick.was_f = f
  let b = key_down('B' as i32)
  if b && !Pick.was_b { give(Orders, Pick.chosen, SHOOT, mx, my, false) }
  Pick.was_b = b
  let fl = key_down('E' as i32)
  if fl && !Pick.was_e { give(Orders, Pick.chosen, FLAME, mx, my, false) }
  Pick.was_e = fl
  let c = key_down('C' as i32)
  if c && !Pick.was_c { give(Orders, Pick.chosen, CHARGE, mx, my, true) }
  Pick.was_c = c
  // The torch toward where the body's middle would be.
  let x = key_down('X' as i32)
  if x && !Pick.was_x { give(Orders, Pick.chosen, CUT, mx, my + 3, false) }
  Pick.was_x = x
  // G: the first chosen to carry the treasure.
  let g = key_down('G' as i32)
  if g && !Pick.was_g { give(Orders, Pick.chosen, CARRY, 0, 0, true) }
  Pick.was_g = g
  let q = key_down('Q' as i32)
  if q && !Pick.was_q { give(Orders, Pick.chosen, SCAN, mx, my, false) }
  Pick.was_q = q
  if key_down(294) { Choice.next = MANUAL }
  if key_down(295) { Choice.next = CAUTIOUS }
  if key_down(296) { Choice.next = BRUTE }
  // Back RING_EVERY ticks (Shift: KEEP_EVERY), paused there; Home to
  // the landing, End to the reach, playing on.
  let r = key_down('R' as i32)
  if r && !Pick.was_r {
    Replay.target = max(0, Now.tick - (if shift { KEEP_EVERY } else { RING_EVERY }))
    Replay.run = false
    Replay.ask = true
  }
  Pick.was_r = r
  let home = key_down(268)
  if home && !Pick.was_home {
    Replay.target = 0
    Replay.run = true
    Replay.ask = true
  }
  Pick.was_home = home
  let end = key_down(269)
  if end && !Pick.was_end {
    Replay.target = Line.reach
    Replay.run = Play.run
    Replay.ask = true
  }
  Pick.was_end = end
  let rew = key_down(259)
  if rew && !Pick.was_rew {
    Back.play = !Back.play
    Back.on = false
    if Back.play {
      Play.run = false
      Alarm.on = false
    }
  }
  Pick.was_rew = rew
  // Slower and faster: 1, 2, 4 times.
  let slow = key_down(44)
  if slow && !Pick.was_slow { Play.speed = max(1, Play.speed / 2) }
  Pick.was_slow = slow
  let quick = key_down(46)
  if quick && !Pick.was_fast { Play.speed = min(4, Play.speed * 2) }
  Pick.was_fast = quick
  let v = key_down('V' as i32)
  if v && !Pick.was_v { Sight.full = !Sight.full }
  Pick.was_v = v
}

// The sprite sheet's poses of the team (art/sprites.py).
const P_STAND = 0
const P_WALK = 2
const P_CLIMB = 6
const P_FLY = 8
const P_FALL = 10
const P_SHOOT = 11
const P_HAUL = 12
const P_CARRY = 13
const P_DOWN = 17

// A pose by what one of the team does: the step under way (`kind`, 0
// none), falling, a tool in use, carrying; `dx`, `dy` where it is drawn
// (walking and climbing step through their frames as it goes).
fn pose(kind: i32, fall: i32, busy: bool, order: i32, carrying: bool, dx: f32, dy: f32, tick: i32, e: i32) -> i32 {
  let stride = (floor(dx) as i32 / 2) % 4
  if kind == FLY { P_FLY + (tick / 4) % 2 }
  else if kind == HAUL { P_HAUL }
  else if kind == VERT { P_CLIMB + (floor(dy) as i32 / 2) % 2 }
  else if kind == DROP || fall > 2 { P_FALL }
  else if kind == WALK || kind == DIG { if carrying { P_CARRY + stride } else { P_WALK + stride } }
  else if carrying { P_CARRY }
  else if busy && order >= SHOOT && order <= SCAN { P_SHOOT }
  else if (tick + e * 37) % 120 < 8 { P_STAND + 1 }
  else { P_STAND }
}

// The Pixaloriens: sprites of 5 by 9 cells (3 by 7 boxes without the
// sheet), facing the way each looks; a grapple's line while it hauls;
// a tool in use shown (`tool_effect`); a red flash when hurt;
// the chosen marked by cyan corners; their ways dotted, where they are
// sent marked.
// A tool in use, drawn by the sprite (at `x`, `y`, `s` points a cell,
// facing `fx`, `fy`; the place aimed at `ax`, `ay` in points): the
// blaster's flash as a bolt leaves, the torch's sparks at the cut, the
// scanner's beam sweeping the rock. (The flamer's fire is matter.)
proc tool_effect(order: i32, cool: i32, x: f32, y: f32, s: f32, fx: f32, fy: f32, tick: i32, e: i32,
                 ax: f32, ay: f32) {
  let hx = if fx >= 0.0 { x + 4.5 * s } else { x + 0.5 * s }
  let hy = y + 4.5 * s
  if order == SHOOT && cool >= BOLT_EVERY - 4 {
    let mx = hx + fx * 1.5 * s
    let my = hy + fy * 1.5 * s
    rect(mx - 1.0 * s, my - 1.0 * s, 2.0 * s, 2.0 * s, 0xc0ffd060)
    rect(mx - 0.5 * s, my - 0.5 * s, 1.0 * s, 1.0 * s, 0xffffff)
  } else if order == CUT {
    let cx = hx + fx * 2.5 * s
    let cy = hy + fy * 2.5 * s
    for i in 0..4 {
      let ox = (lattice(tick, e * 8 + i, 41) - 0.5) * 4.0 * s
      let oy = (lattice(tick, e * 8 + i, 42) - 0.5) * 4.0 * s
      rect(cx + ox, cy + oy, 0.6 * s, 0.6 * s, if i % 2 == 0 { 0xffe080 } else { 0xffffff })
    }
  } else if order == SCAN {
    // A fan from the eye toward the place, swinging.
    let ex = x + 2.5 * s
    let ey = y + 1.5 * s
    let dx = ax - ex
    let dy = ay - ey
    let swing = sin(tick as f32 * 0.12) * 0.25
    for i in 0..3 {
      let a = swing + (i - 1) as f32 * 0.06
      let c = cos(a)
      let sn = sin(a)
      line(ex, ey, ex + dx * c - dy * sn, ey + dx * sn + dy * c, 0x6040e0ff)
    }
  }
}

system draw_team() {
  let s = Camera.scale
  let sheet = Sheet.id
  for p: Pixalorien in turn by p.id {
    let e = p.id
    let px = Feet[e].dx
    let py = Feet[e].dy
    let chosen = Pick.chosen & (1 << e) != 0
    let kind = if p.t > 0 { Way[e * MAXWAY + p.k].kind as i32 } else { 0 }
    if sheet > 0 {
      let row = (e * 2 + (if Team[e].fx >= 0.0 { 0 } else { 1 })) as f32 * 10.0
      let x = (px - 2.0 - Camera.x) * s
      let y = (py - 8.0 - Camera.y) * s
      if p.down {
        picture_part(sheet, P_DOWN as f32 * 10.0, row, 9.0, 3.0, x - 2.0 * s, y + 6.0 * s, 9.0 * s, 3.0 * s, 0xffffff)
      } else {
        let k = pose(kind, p.fall, p.busy, p.order, Loot.by == e, px, py, Sim.tick, e)
        if kind == HAUL {
          let wn = Way[e * MAXWAY + p.k].n
          // The line to where its hook holds (on the ledge's edge).
          let a = hook(Cells, p.ex, wn)
          if a >= 0 {
            let hand = if Team[e].fx >= 0.0 { x + 4.5 * s } else { x + 0.5 * s }
            let ax = (w_x(a) as f32 + 0.5 - Camera.x) * s
            let ay = ((a % H) as f32 + 0.5 - Camera.y) * s
            line(hand, y + 0.5 * s, ax, ay, 0xb0b0b0)
            rect(ax - 0.5 * s, ay - 0.5 * s, s, s, 0xffd0d0d0)
          }
        }
        // Hurt: a red flash.
        let tint = if Sim.tick - p.struck < 8 { 0xff6050 } else { 0xffffff }
        picture_part(sheet, k as f32 * 10.0, row, 5.0, 9.0, x, y, 5.0 * s, 9.0 * s, tint)
        if p.busy { tool_effect(p.order, p.cool, x, y, s, Team[e].fx, Team[e].fy, Sim.tick, e,
                                (p.tx as f32 + 0.5 - Camera.x) * s, (p.ty as f32 + 0.5 - Camera.y) * s) }
      }
      if chosen {
        // Corners round the sprite.
        let x0 = x - s
        let y0 = y - s
        let x1 = x + 6.0 * s
        let y1 = y + 10.0 * s
        let c = 1.5 * s
        line(x0, y0, x0 + c, y0, 0x40e0ff)
        line(x0, y0, x0, y0 + c, 0x40e0ff)
        line(x1, y0, x1 - c, y0, 0x40e0ff)
        line(x1, y0, x1, y0 + c, 0x40e0ff)
        line(x0, y1, x0 + c, y1, 0x40e0ff)
        line(x0, y1, x0, y1 - c, 0x40e0ff)
        line(x1, y1, x1 - c, y1, 0x40e0ff)
        line(x1, y1, x1, y1 - c, 0x40e0ff)
      }
    } else {
      let x = (px - 1.0 - Camera.x) * s
      let y = (py - 6.0 - Camera.y) * s
      if p.down {
        // Lying where it fell.
        rect(x - 2.0 * s, y + 4.0 * s, 7.0 * s, 3.0 * s, 0x707880)
        rect(x - 2.0 * s, y + 4.0 * s, 2.0 * s, 3.0 * s, 0x8a3030)
      } else {
        rect(x, y, 3.0 * s, 7.0 * s, if chosen { 0xe8f0ff } else { 0xa0aab8 })
        rect(x, y + 4.0 * s, 3.0 * s, 3.0 * s, 0x5a6878)
        let vx = if Team[e].fx >= 0.0 { x + 1.5 * s } else { x }
        rect(vx, y + 1.0 * s, 1.5 * s, s, 0x40e0ff)
      }
      if chosen {
        let gx = x - 2.0 * s
        let gy = y - 2.0 * s
        line(gx, gy, gx + 7.0 * s, gy, 0xffffff)
        line(gx, gy + 11.0 * s, gx + 7.0 * s, gy + 11.0 * s, 0xffffff)
        line(gx, gy, gx, gy + 11.0 * s, 0xffffff)
        line(gx + 7.0 * s, gy, gx + 7.0 * s, gy + 11.0 * s, 0xffffff)
      }
    }
  }
  for p: Pixalorien in turn by p.id {
    if Pick.chosen & (1 << p.id) != 0 {
      if p.order != IDLE && p.len > p.k {
        // Where it will be in five seconds, by its way.
        var left = RING_EVERY
        var j = p.k
        if p.t > 0 {
          left -= Way[p.id * MAXWAY + j].cost - p.t
          j += 1
        }
        while j < p.len - 1 && left > Way[p.id * MAXWAY + j].cost {
          left -= Way[p.id * MAXWAY + j].cost
          j += 1
        }
        let n = Way[p.id * MAXWAY + min(j, p.len - 1)].n
        let gx = ((n / H) as f32 - 1.0 - Camera.x) * s
        let gy = ((n % H) as f32 - 6.0 - Camera.y) * s
        line(gx, gy, gx + 3.0 * s, gy, 0x80f0ff)
        line(gx, gy + 7.0 * s, gx + 3.0 * s, gy + 7.0 * s, 0x80f0ff)
        line(gx, gy, gx, gy + 7.0 * s, 0x80f0ff)
        line(gx + 3.0 * s, gy, gx + 3.0 * s, gy + 7.0 * s, 0x80f0ff)
      }
      if p.order != IDLE {
        var j = p.k
        while j < p.len {
          let n = Way[p.id * MAXWAY + j].n
          let kind = Way[p.id * MAXWAY + j].kind as i32
          let c = if kind == HAUL { 0xffe060 } else if kind == FLY { 0xff7040 } else if kind == DIG { 0xc08040 } else { 0x80f0ff }
          rect(((n / H) as f32 - Camera.x) * s, ((n % H) as f32 - Camera.y) * s, s, s, c)
          j += 4
        }
      }
      if tool(p.order) {
        // (The torch's place is where the feet go: drawn where it was
        // aimed, at the body's middle.)
        let cx = (p.tx as f32 + 0.5 - Camera.x) * s
        let cy = (p.ty as f32 + 0.5 - (if p.order == CUT { 3.0 } else { 0.0 }) - Camera.y) * s
        line(cx - 6.0, cy, cx + 6.0, cy, 0xff8060)
        line(cx, cy - 6.0, cx, cy + 6.0, 0xff8060)
      }
      if p.order == GO {
        circle((p.gx as f32 + 0.5 - Camera.x) * s, (p.gy as f32 + 0.5 - Camera.y) * s, 4.0, 0x80f0ff)
      }
      if Orders[p.id].set && Orders[p.id].order != IDLE && Orders[p.id].order != FOLLOW {
        let up = if Orders[p.id].order == CUT { 3.0 } else { 0.0 }
        circle((Orders[p.id].gx as f32 + 0.5 - Camera.x) * s, (Orders[p.id].gy as f32 + 0.5 - up - Camera.y) * s, 4.0, 0xffffff)
      }
    }
  }
}

fn order_name(o: i32) -> text[8] {
  if o == GO { "go" } else if o == FOLLOW { "follow" } else if o == SHOOT { "blaster" } else if o == FLAME { "flamer" }
  else if o == CHARGE { "charge" } else if o == CUT { "torch" } else if o == SCAN { "scan" } else if o == FLARE { "flare" }
  else if o == CARRY { "carry" } else { "wait" }
}

fn strategy_name(s: i32) -> text[12] { if s == MANUAL { "manual" } else if s == CAUTIOUS { "cautious" } else { "brute force" } }

fn state_name(down: bool, o: i32) -> text[8] { if down { "down" } else { order_name(o) } }

// A tick as minutes and seconds.
fn clock_text(t: i32) -> text[16] {
  let s = t / SECOND
  if s % 60 < 10 { "{s / 60}:0{s % 60}" } else { "{s / 60}:{s % 60}" }
}

// Bolts, charges and flares in flight (a blast: particles.ent).
system draw_shots() {
  let s = Camera.scale
  for i in 0..SHOTS {
    if Shots[i].on {
      let x = (Shots[i].x - Camera.x) * s
      let y = (Shots[i].y - Camera.y) * s
      let k = Shots[i].kind
      if k == BOLT {
        line(x, y, x - Shots[i].ux * 6.0 * s, y - Shots[i].uy * 6.0 * s, 0xff4030)
      } else {
        let blink = k == BOMB && (Shots[i].fuse / 8) % 2 == 0
        rect(x - s, y - s, 2.0 * s, 2.0 * s, if k == LIGHT { 0xfff4c0 } else if blink { 0xff3020 } else { 0x603020 })
      }
    }
  }
}

// The box being dragged.
system draw_box() {
  if Pick.pressing && max(abs(Mouse.x - Pick.px), abs(Mouse.y - Pick.py)) >= 6.0 {
    let x0 = min(Pick.px, Mouse.x)
    let y0 = min(Pick.py, Mouse.y)
    let x1 = max(Pick.px, Mouse.x)
    let y1 = max(Pick.py, Mouse.y)
    rect(x0, y0, x1 - x0, y1 - y0, 0x2080f0ff)
    line(x0, y0, x1, y0, 0x80f0ff)
    line(x0, y1, x1, y1, 0x80f0ff)
    line(x0, y0, x0, y1, 0x80f0ff)
    line(x1, y0, x1, y1, 0x80f0ff)
  }
}

// The turn's bar and the team in words (the checks'; the game has the
// HUD, hud.ent).
system draw_bar() {
  let y = Window.height as f32 - 34.0
  rect(12.0, y, 300.0, 8.0, 0x202028)
  rect(12.0, y, 300.0 * Now.tick as f32 / max(1, Line.reach) as f32, 8.0, if Sim.run { 0x80f0ff } else { 0x707070 })
  label("{clock_text(Now.tick)}", 12.0, y - 24.0, 18.0, 0xffffff)
  if !Sim.run && !Replay.on { label("paused", 110.0, y - 24.0, 18.0, 0xffd060) }
  if Replay.on { label("going to {clock_text(Replay.target)}", 110.0, y - 24.0, 18.0, 0xffd060) }
  if Replay.failed { label("no saved world to go back to", 110.0, y - 24.0, 18.0, 0xff6060) }
  label("{strategy_name(Plan.strategy)}", 400.0, y - 24.0, 18.0, 0x80f0ff)
  for p: Pixalorien in turn by p.id {
    label("{p.id + 1}: {state_name(p.down, p.order)}  armour {max(0, p.hp)}  fuel {p.fuel / 10}  charges {p.charges}  flares {p.flares}",
          330.0 + p.id as f32 * 300.0, y - 6.0, 16.0,
          if Pick.chosen & (1 << p.id) != 0 { 0xffffff } else { 0xa0a0a0 })
  }
}

schedule draw_turn() {
  draw_box()
  draw_bar()
}

world {
  Orders = [{ set: false, order: IDLE, gx: 0, gy: 0, lead: 0, auto: false }; 3]
  OrderLog = [{ tick: 0, who: 0, order: IDLE, gx: 0, gy: 0, lead: 0 }; 16384]
  Ring = [{ tick: -1 }; 6]
  Kept = [{ ok: false }; 256]
  Pins = [{ tick: 0, kind: 0, who: -1 }; 1024]
  // All but dangerous matter seen (it can come often).
  Pauses.on = 255 - (1 << EV_DANGER)
  Choice.next = CAUTIOUS
  Line.saved = -1
  Pick.chosen = 1
}
