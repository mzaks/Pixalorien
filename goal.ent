// The goal: the treasure carried to the ship.
//
// The chest lies on the vault's floor. One sent to carry it (CARRY, key
// G) goes to it and lifts it (`lift`): the chest's cells are gone from
// the floor and it is on that one's back. The carrier walks at half the
// pace and cannot fly (team.ent: `route`, `move`). Should it go down,
// the chest falls where it lies (`carried`) and another can lift it.
// The game is won when the carrier stands by the ship (80 cells from
// its middle at most), and lost when
// nobody is left (`Game`).
import window
import clock
import math
import matter
import gen
import view
import sight
import team
import turns
import alarms
import tools
import creatures
import journal
import particles
import world
import saver

// How near the chest one must be to lift it.
const REACH_X = 12
const REACH_Y = 8
// The way each one went and the rock as it was, for the end's screen
// (results.ent): a row a soldier every TRACK_EVERY ticks; blocks of the
// world, DIG_W by DIG_H, by how many cells of them are solid.
const TRACK_EVERY = 60
const TRACK_ROWS = 32766
const DIG_W = 384
const DIG_H = 192
// (By the tick, so a game gone back over writes its rows anew; neither
// is in the world: the simulation does not read them.)
transient buffer Track { x: i32, y: i32, carry: bool, down: bool } capacity 32766
transient buffer Rock { n: i32 } capacity 73728

// A new game: the chest in the vault.
system new_loot() {
  Loot.by = -1
  Loot.x = Places.vault_x
  Loot.y = Places.vault_y - 1
  Loot.lifted = false
  Loot.dropped = 0
  Game.over = 0
  Game.at = -1
}

// Where one sent to carry goes: beside the chest in the vault (it is in
// the way), else where it lies.
fn loot_x(lifted: bool, x: i32, side: i32) -> i32 { if lifted { x } else { x - side * 10 } }

system lift() {
  for p: mut Pixalorien in turn by p.id {
    if p.order == CARRY && !p.down {
      if Loot.by >= 0 && Loot.by != p.id {
        p.order = IDLE
        p.mine = false
      } else if Loot.by < 0 && iabs(p.x - Loot.x) <= REACH_X && iabs(p.y - Loot.y) <= REACH_Y && p.t == 0 {
        Loot.by = p.id
        p.order = IDLE
        p.mine = false
        p.len = 0
        p.k = 0
      }
    }
  }
}

// The chest's cells gone from the vault's floor once it is lifted; the
// chest dropped where its carrier went down; the game's end.
system carried() {
  if Loot.by >= 0 && !Loot.lifted {
    Loot.lifted = true
    let vx = Places.vault_x
    let vy = Places.vault_y
    for x in vx - 6..vx + 6 {
      for y in vy - 8..vy {
        if Cells[at(x, y)].m == Matter.Treasure { set_cell(Cells, Stir, x, y, Matter.Air, 0) }
      }
    }
  }
  if Loot.by >= 0 && Feet[Loot.by].down {
    Loot.x = Feet[Loot.by].x
    Loot.y = Feet[Loot.by].y
    Loot.by = -1
    Loot.dropped += 1
  }
  if Game.over == 0 {
    if Loot.by >= 0 && max(iabs(Feet[Loot.by].x - Places.ship_x), iabs(Feet[Loot.by].y - Places.ship_y)) <= 80 && Hull.damage == 0 {
      Game.over = 1
      Game.at = Now.tick
    }
    var up = 0
    for e in 0..TEAM { if !Feet[e].down { up += 1 } }
    if up == 0 {
      Game.over = 2
      Game.at = Now.tick
    }
  }
}

// The tech repairs the ship (after a rough landing) while it stands
// beside it with nothing else to do: a unit every REPAIR_EVERY ticks,
// sparks off the hull and a knock every half second.
system repair() {
  if Hull.damage > 0 {
    let t = Sim.tick
    let sx = Places.ship_x
    let sy = Places.ship_y
    for p: Pixalorien in turn by p.id {
      if p.id == TECH && !p.down && !p.busy && p.order == IDLE && p.fall == 0 && Loot.by != p.id
         && iabs(p.x - sx) <= REPAIR_NEAR && iabs(p.y - sy) <= 30 {
        if t % REPAIR_EVERY == 0 { Hull.damage -= 1 }
        if t % 30 == 0 {
          let hx = iclamp(p.x, sx - 28, sx + 28)
          if Puffed.n < PUFFS {
            Puffs[Puffed.n].x = hx
            Puffs[Puffed.n].y = sy - 9
            Puffs[Puffed.n].kind = PUFF_HIT
            Puffs[Puffed.n].a = 0.0
            Puffs[Puffed.n].b = 1.0
            Puffs[Puffed.n].c = 0x8090a0
            Puffed.n += 1
          }
          if Banged.n < BANGS {
            Bangs[Banged.n].x = hx
            Bangs[Banged.n].y = sy - 9
            Bangs[Banged.n].kind = BANG_HIT
            Banged.n += 1
          }
        }
      }
    }
  }
}

// The ship, drawn over its cells (art/sprites.png, made by
// art/sprites.py from the same shape): plates, rust, the team's stripe,
// the canopy; its nozzle glowing, flickering.
system draw_ship() {
  let sheet = Sheet.id
  if sheet > 0 {
    let s = Camera.scale
    let side = Places.side
    let ox = (Places.ship_x - (if side > 0 { 34 } else { 33 })) as f32
    let oy = (Places.ship_y - 37) as f32
    picture_part(sheet, 0.0, if side > 0 { 104.0 } else { 145.0 }, 68.0, 41.0,
                 (ox - Camera.x) * s, (oy - Camera.y) * s, 68.0 * s, 41.0 * s, 0xffffff)
    let nx = (Places.ship_x - side * 33) as f32 + (if side > 0 { 0.0 } else { 1.0 })
    let ny = (Places.ship_y - 16) as f32
    let a = 96 + ((Window.frame * 37) % 64) as i32
    let w = 1.5 + ((Window.frame / 3) % 2) as f32
    rect((nx - (if side > 0 { w } else { 0.0 }) - Camera.x) * s, (ny - 1.0 - Camera.y) * s, w * s, 3.0 * s, (a << 24) | 0xffa040)
  }
}

// The chest: on its carrier's back, or where it lies.
system draw_loot() {
  let s = Camera.scale
  if Loot.by >= 0 && Sheet.id > 0 {
    // (In the carrier's arms on its sprite.)
  } else if Loot.lifted && Sheet.id > 0 {
    picture_part(Sheet.id, 0.0, 100.0, 6.0, 4.0, (Loot.x as f32 - 3.0 - Camera.x) * s, (Loot.y as f32 - 3.0 - Camera.y) * s,
                 6.0 * s, 4.0 * s, 0xffffff)
  } else if Loot.by >= 0 {
    let e = Loot.by
    let x = (Feet[e].dx - 1.0 - Team[e].fx * 1.5 - Camera.x) * s
    let y = (Feet[e].dy - 6.0 - Camera.y) * s
    rect(x, y + 1.0 * s, 3.0 * s, 3.0 * s, 0xd8a420)
    rect(x, y + 2.0 * s, 3.0 * s, 0.5 * s, 0xfff0a0)
  } else if Loot.lifted {
    let x = (Loot.x as f32 - 3.0 - Camera.x) * s
    let y = (Loot.y as f32 - 3.0 - Camera.y) * s
    rect(x, y, 6.0 * s, 4.0 * s, 0xd8a420)
    rect(x, y + 1.5 * s, 6.0 * s, 0.6 * s, 0xfff0a0)
  }
}

system rock_map() {
  for b in 0..DIG_W * DIG_H {
    let cx = b % DIG_W
    let cy = b / DIG_W
    var n = 0
    for x in cx * W / DIG_W..(cx + 1) * W / DIG_W {
      for y in cy * H / DIG_H..(cy + 1) * H / DIG_H {
        if team::solid(Cells[at(x, y)].m) { n += 1 }
      }
    }
    Rock[b].n = n
  }
}

system track() {
  let t = Now.tick / TRACK_EVERY
  if t < TRACK_ROWS / TEAM {
    for e in 0..TEAM {
      let row = t * TEAM + e
      Track[row].x = Feet[e].x
      Track[row].y = Feet[e].y
      Track[row].carry = Loot.by == e
      Track[row].down = Feet[e].down
    }
  }
}

fn loot_text(by: i32, lifted: bool) -> text[32] {
  if by >= 0 { "treasure: carried by {by + 1}" } else if lifted { "treasure: dropped" } else { "treasure: in the vault" }
}

system draw_goal() {
  if Game.over == 0 && Hull.damage > 0 {
    // The ship to repair (and the treasure waiting on it).
    let w = Window.width as f32
    let done = (ROUGH_DAMAGE - Hull.damage) * 100 / ROUGH_DAMAGE
    rect(w / 2.0 - 300.0, 44.0, 600.0, 30.0, 0xc0101418)
    let aboard = Loot.by >= 0 && max(iabs(Feet[Loot.by].x - Places.ship_x), iabs(Feet[Loot.by].y - Places.ship_y)) <= 80
    if aboard {
      label("THE TREASURE IS HERE: THE SHIP IS NOT REPAIRED ({done}%)", w / 2.0 - 285.0, 50.0, 18.0, 0xff7060)
    } else {
      label("SHIP DAMAGED: THE TECH REPAIRS IT, IDLE BESIDE IT ({done}%)", w / 2.0 - 285.0, 50.0, 18.0, 0xffc040)
    }
  }
}

// The world's steps, a tick: in a frame (when the player lets it run),
// or in the quick passes going back. Its start (a checkpoint), the cave's
// phases (matter.ent's `step`), and the rest; with `Spread.part` only the
// part `Spread.at` (see `stage`).
schedule sim_begin() {
  checkpoint() run_if (Sim.run && !Replay.on) && (!Spread.part || Spread.at == 0)
  save_world_bg() run_if (Line.save) && (!Spread.part || Spread.at == 0)
  save_world_poll() run_if (!Spread.part || Spread.at == 0)
  saved() run_if (Line.save) && (!Spread.part || Spread.at == 0)
  rock_map() run_if (Sim.run && Now.tick == 0) && (!Spread.part || Spread.at == 0)
}

// (The orders of the tick, the player's, the log's or a run's, are taken
// after the cave's phases, which neither read nor change them: in a tick
// over several frames those given in any of them are logged with it.)
schedule sim_end() {
  branch() run_if (Sim.run && !Replay.on && Now.tick < Line.reach) && (!Spread.part || Spread.at == 13)
  replay_orders() run_if (Sim.run && Now.tick < Line.reach) && (!Spread.part || Spread.at == 13)
  note_start() run_if (Sim.run && Now.tick == 0) && (!Spread.part || Spread.at == 13)
  feed_run() run_if (Sim.run && Feed.on && Now.tick >= Line.reach) && (!Spread.part || Spread.at == 13)
  log_orders() run_if (Sim.run && Now.tick >= Line.reach) && (!Spread.part || Spread.at == 13)
  autopilot() run_if (Sim.run && Now.tick % BEAT == 0 && Plan.strategy != MANUAL) && (!Spread.part || Spread.at == 13)
  take_orders() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  work() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  guard() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  find_ways() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  move() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  tread() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  bolt_hits() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  fly() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  listen() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  prowl() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  spit_fly() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  harm() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  wounds() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  mark_downs() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  watch_team() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  perils() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  watch() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  lift() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  repair() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  carried() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  track() run_if (Sim.run && (Now.tick % TRACK_EVERY == 0 || Game.over != 0)) && (!Spread.part || Spread.at == 13)
  clock() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  eyes() run_if (Sim.run) && (!Spread.part || Spread.at == 13)
  // Sight every second tick (the round lasts both: what was seen stays
  // seen-now until the next round), and the ways' map from it in the
  // tick after: neither tick pays for all of it (the rays and what they
  // see, 3.5 ms on one core, then the map, 1.5 ms), at any speed, and a
  // replay — which meets the same ticks — sees the same world.
  cast() run_if (Sim.run && Sim.tick % 2 == 0) && (!Spread.part || Spread.at == 13)
  next_round() run_if (Sim.run && Sim.tick % 2 == 0) && (!Spread.part || Spread.at == 13)
  see() run_if (Sim.run && Sim.tick % 2 == 0) && (!Spread.part || Spread.at == 13)
  navigate() run_if (Sim.run && Sim.tick % 2 == 1) && (!Spread.part || Spread.at == 13)
  unfresh() run_if (Sim.run && Sim.tick % 2 == 1) && (!Spread.part || Spread.at == 13)
  log_count() run_if (Sim.run && Back.ready) && (!Spread.part || Spread.at == 13)
  log_place() run_if (Sim.run && Back.ready) && (!Spread.part || Spread.at == 13)
  log_write() run_if (Sim.run && Back.ready) && (!Spread.part || Spread.at == 13)
  pack() run_if (Sim.run && Back.ready) && (!Spread.part || Spread.at == 13)
  log_small() run_if (Sim.run && Back.ready) && (!Spread.part || Spread.at == 13)
  log_sum() run_if (Sim.run && Back.ready) && (!Spread.part || Spread.at == 13)
  motes_step() run_if (Sim.run && !Replay.on) && (!Spread.part || Spread.at == 13)
}

schedule sim() {
  sim_begin()
  step()
  sim_end()
}

// A tick in parts, in a frame (pixalorien.ent): `stage` runs one part of
// it and says whether the frame has spent its time (`Spread.out`), or
// the tick is done, or there is none to run. On a web page a frame has
// 10 ms for the world (its drawing takes the rest of the 16.7), so where
// the cave is busy a tick goes over two or three frames and the window
// keeps its pace; elsewhere it has no limit, and a frame runs a whole
// tick as before.
system part_on() { Spread.part = true }
system part_next() {
  let idle = Spread.at == 0 && !Sim.run
  Spread.at = if idle || Spread.at == 13 { 0 } else { Spread.at + 1 }
  Spread.part = false
  Spread.out = Spread.at == 0 || wait_until(0.0) - Spread.from > Spread.budget
}
schedule stage() {
  part_on()
  sim()
  part_next()
}

system pace() {
  let web = web_page()
  Spread.budget = if web { 0.010 } else { 1000000.0 }
  Spread.quick = if web { 0.010 } else { 0.05 }
}

world {
  Loot.by = -1
  Track = [{ x: 0, y: 0, carry: false, down: false }; 32766]
  Rock = [{ n: 0 }; 73728]
}
