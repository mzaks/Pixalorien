// Effects drawn over the world: the scan and the cries the team hears.
// All are drawn from the world as it is and its tick (`Sim.tick`), with
// nothing of their own, so they play backwards with it too (journal.ent).
// They are made of blocks a cell big, on the cells' grid, as the world
// is.
//
// - The scan (tools.ent): pulses go out from the place scanned every
//   SCAN_PULSE ticks to the scan's reach, bright where they go through
//   rock and dim through open space (the echo); a dashed ring at the
//   reach fills in, clockwise from the top, as the scan goes on; when it
//   is done, a ring sweeps out over what it made known, glints coming
//   and going behind it.
// - A creature's cry the team heard (creatures.ent, `Noises` of a
//   creature): amber ripples, ( and ), spread from where it cried and
//   fade over the 90 ticks it is heard; where that is outside the view,
//   an amber arrow at the view's edge points toward it, ripples in front
//   of it.
import window
import math
import matter
import gen
import view
import sight
import team
import tools
import creatures

const SCAN_PULSE = 60
const SCAN_INK = 0x80f0ff
const SCAN_HOT = 0xe8ffff
const CRY_INK = 0xffc040
const CRY_TICKS = 90
const DONE_TICKS = 60

// A colour as strong as `a` (0 to 1; 0 is not drawn: the window takes
// an alpha of 0 for no alpha at all).
fn tint(rgb: i32, a: f32) -> i32 { ((clamp(a, 0.0, 1.0) * 255.0) as i32 << 24) | (rgb & 0xffffff) }

// A block a cell big at a cell (`cx`, `cy` the camera's cell, `s` points
// a cell).
proc block(ix: i32, iy: i32, s: f32, cx: f32, cy: f32, color: i32) {
  rect((ix as f32 - cx) * s, (iy as f32 - cy) * s, s, s, color)
}

// A ring of blocks round a cell, `r` cells out, from angle `from` to
// `to` (radians, clockwise from the right, as y goes down), every
// `every`th block of it.
proc ring(x: i32, y: i32, r: f32, from: f32, to: f32, every: i32, s: f32, cx: f32, cy: f32, color: i32) {
  let n = max(8, (r * abs(to - from)) as i32)
  for k in 0..n {
    if k % every == 0 {
      let a = from + (to - from) * (k as f32 + 0.5) / n as f32
      block(x + floor(cos(a) * r + 0.5) as i32, y + floor(sin(a) * r + 0.5) as i32, s, cx, cy, color)
    }
  }
}

// A pulse of a scan: brighter where it goes through what is not open.
proc pulse(x: i32, y: i32, r: f32, a: f32, cells: Cells, s: f32, cx: f32, cy: f32) {
  let n = max(8, (r * 6.2832) as i32)
  for k in 0..n {
    let t = 6.2832 * k as f32 / n as f32
    let bx = x + floor(cos(t) * r + 0.5) as i32
    let by = y + floor(sin(t) * r + 0.5) as i32
    if inside(bx, by) {
      let rock = !open(cells[at(bx, by)].m)
      block(bx, by, s, cx, cy, if rock { tint(SCAN_HOT, a * 0.9) } else { tint(SCAN_INK, a * 0.3) })
    }
  }
}

system draw_scans() {
  let s = Camera.scale
  let cx = Camera.x
  let cy = Camera.y
  let tick = Sim.tick
  for p: Pixalorien in turn by p.id {
    if p.order == SCAN && p.busy && !p.down {
      let x = p.tx
      let y = p.ty
      let f = p.work as f32 / SCAN_TICKS as f32
      let top = -1.5708
      // The reach: dashed, and the part done whole and bright.
      ring(x, y, SCAN_DEPTH as f32, top + 6.2832 * f, top + 6.2832, 3, s, cx, cy, tint(SCAN_INK, 0.35))
      ring(x, y, SCAN_DEPTH as f32, top, top + 6.2832 * f, 1, s, cx, cy, tint(SCAN_INK, 0.85))
      // Two pulses out.
      for j in 0..2 {
        let q = ((p.work + j * SCAN_PULSE / 2) % SCAN_PULSE) as f32 / SCAN_PULSE as f32
        let r = q * SCAN_DEPTH as f32
        if r >= 1.0 { pulse(x, y, r, 1.0 - q, Cells, s, cx, cy) }
      }
      // The place: a core that beats with the pulses.
      let beat = 1.0 - ((p.work % (SCAN_PULSE / 2)) as f32 / (SCAN_PULSE / 2) as f32)
      block(x, y, s, cx, cy, tint(SCAN_HOT, 0.5 + 0.5 * beat))
      ring(x, y, 1.0 + beat, 0.0, 6.2832, 1, s, cx, cy, tint(SCAN_INK, 0.6 * beat))
    }
  }
  // Done: a ring sweeping out, glints behind it.
  let age = tick - Tools.st
  if age >= 0 && age < DONE_TICKS {
    let x = Tools.sx
    let y = Tools.sy
    let k = 1.0 - age as f32 / DONE_TICKS as f32
    let r = min(SCAN_DEPTH as f32, age as f32 * 2.0)
    ring(x, y, r, 0.0, 6.2832, 1, s, cx, cy, tint(SCAN_HOT, k))
    if r > 2.0 { ring(x, y, r - 1.5, 0.0, 6.2832, 2, s, cx, cy, tint(SCAN_INK, 0.5 * k)) }
    for g in 0..90 {
      let gx = ((lattice(Tools.st, g, 51) * 2.0 - 1.0) * SCAN_DEPTH as f32) as i32
      let gy = ((lattice(Tools.st, g, 52) * 2.0 - 1.0) * SCAN_DEPTH as f32) as i32
      let d = sqrt((gx * gx + gy * gy) as f32)
      // Each glint lights as the ring passes it, and twinkles out.
      let since = age - (d / 2.0) as i32
      if d <= SCAN_DEPTH as f32 && d <= r && since >= 0 && since < 24 {
        let on = (since / 4 + g) % 3 != 0
        if on { block(x + gx, y + gy, s, cx, cy, tint(if g % 3 == 0 { 0xffffff } else { SCAN_HOT }, k * (1.0 - since as f32 / 24.0))) }
      }
    }
  }
}

// An arrow toward (`ux`, `uy`), its tip at (`x`, `y`): a wedge of
// blocks `size` points big, on a dark edge so it shows on sand and sky.
proc arrow_to(x: f32, y: f32, ux: f32, uy: f32, size: f32, color: i32) {
  let px = -uy
  let py = ux
  for pass in 0..2 {
    let grow = if pass == 0 { 1.6 } else { 1.0 }
    let c = if pass == 0 { 0xc0201008 } else { color }
    for i in 0..7 {
      let back = i as f32 * size * 0.8
      for j in -i..i + 1 {
        rect(x - ux * back + px * j as f32 * size * 0.7 - size * grow / 2.0,
             y - uy * back + py * j as f32 * size * 0.7 - size * grow / 2.0, size * grow, size * grow, c)
      }
    }
  }
}

system draw_cries() {
  let s = Camera.scale
  let cx = Camera.x
  let cy = Camera.y
  let ww = Camera.w
  let wh = Camera.h
  let tick = Sim.tick
  for i in 0..NOISES {
    if Noises[i].from == 1 && Noises[i].heard && Noises[i].until >= tick && Noises[i].until - CRY_TICKS <= tick {
      let a = CRY_TICKS - (Noises[i].until - tick)
      let fade = 1.0 - a as f32 / CRY_TICKS as f32
      let nx = Noises[i].x
      let ny = Noises[i].y
      let x = (nx as f32 + 0.5 - cx) * s
      let y = (ny as f32 + 0.5 - cy) * s
      let margin = 30.0
      if x >= margin && x <= ww - margin && y >= margin && y <= wh - margin {
        // Ripples: ( and ), three going out.
        for j in 0..3 {
          let q = ((a + j * 10) % 30) as f32 / 30.0
          let r = 3.0 + q * 9.0
          let c = tint(CRY_INK, (1.0 - q) * fade)
          let soft = tint(CRY_INK, 0.5 * (1.0 - q) * fade)
          ring(nx, ny, r, -0.85, 0.85, 1, s, cx, cy, c)
          ring(nx, ny, r, 2.29, 3.99, 1, s, cx, cy, c)
          ring(nx, ny, r + 1.0, -0.85, 0.85, 1, s, cx, cy, soft)
          ring(nx, ny, r + 1.0, 2.29, 3.99, 1, s, cx, cy, soft)
        }
        block(nx, ny, s, cx, cy, tint(CRY_INK, fade))
      } else {
        // At the edge, toward it.
        let ex = clamp(x, margin, ww - margin)
        let ey = clamp(y, margin, wh - margin)
        let dx = x - ex
        let dy = y - ey
        let d = max(0.001, sqrt(dx * dx + dy * dy))
        let ux = dx / d
        let uy = dy / d
        let beat = ((a % 20) as f32) / 20.0
        // Arcs going out from behind the arrow toward it, then the arrow.
        let bx = ex - ux * 40.0
        let by = ey - uy * 40.0
        for j in 0..3 {
          let q = (beat + j as f32 / 3.0) - floor(beat + j as f32 / 3.0)
          let r = 12.0 + q * 22.0
          let n = 9
          for k in 0..n {
            let t = atan2(uy, ux) + (k as f32 / (n - 1) as f32 - 0.5) * 1.3
            rect(bx + cos(t) * r - 2.0, by + sin(t) * r - 2.0, 4.0, 4.0, tint(CRY_INK, (1.0 - q) * (0.3 + 0.7 * fade)))
          }
        }
        arrow_to(ex + ux * 4.0, ey + uy * 4.0, ux, uy, 4.0, tint(CRY_INK, 0.5 + 0.5 * fade))
      }
    }
  }
}
